<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to HR.Web/secrets.config and fill in real values.
  secrets.config is gitignored — never commit SMTP passwords or API keys.
-->
<appSettings>
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpUser" value="your-email@gmail.com" />
  <add key="SmtpPassword" value="your-16-char-app-password" />
  <add key="SmtpEnableSsl" value="true" />
  <add key="FromEmail" value="noreply@example.com" />
  <add key="FromName" value="NanoHireHub" />
  <add key="LinkedInClientId" value="" />
  <add key="LinkedInClientSecret" value="" />
  <add key="LinkedInApiVersion" value="202402" />
  <add key="SystemEncryptionKey" value="replace-with-a-long-random-key" />
</appSettings>
