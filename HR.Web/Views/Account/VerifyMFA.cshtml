@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Authentication Required";
    ViewBag.HideNavbar = true;
    ViewBag.SuppressPageHero = true;
    var tenantToken = ViewContext.RouteData.Values["tenant"] as string;
    var tenantContext = ViewBag.TenantContext as HR.Web.Models.Company;
    var tenantCompanyName = tenantContext != null && !string.IsNullOrWhiteSpace(tenantContext.Name)
        ? tenantContext.Name
        : null;
}

<div class="mfa-setup-wrapper mfa-setup-wrapper-login animate-fadeIn">
    <div class="mfa-card auth-login-card">
        <div class="auth-login-layout">
            <aside class="auth-login-aside">
                <div class="login-icon-wrap">
                    <i class="fas fa-shield-alt"></i>
                </div>
                @if (!string.IsNullOrEmpty(tenantCompanyName))
                {
                    <span class="auth-eyebrow">@tenantCompanyName</span>
                    <h3>Two-step verification</h3>
                    <p class="auth-login-aside__lead">Enter the verification code sent to your email to sign in to @tenantCompanyName.</p>
                }
                else
                {
                    <span class="auth-eyebrow">Two-step verification</span>
                    <h3>Verify your identity</h3>
                    <p class="auth-login-aside__lead">Complete verification to access your account.</p>
                }
                <ul class="auth-login-features">
                    <li><i class="fas fa-check-circle"></i> Enter the 6-digit code from your inbox</li>
                    <li><i class="fas fa-check-circle"></i> Codes expire after 10 minutes</li>
                    <li><i class="fas fa-check-circle"></i> Check spam if the message doesn't arrive</li>
                </ul>
            </aside>

            <div class="auth-login-main">
                <div class="mfa-body auth-login-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert auth-alert alert-danger mb-4" })

                    <div id="mfaSendStatus" class="alert auth-alert alert-info mb-4" role="status" aria-live="polite">
                        <i class="fas fa-info-circle mr-2"></i>
                        <span id="mfaSendStatusText">
                            @if (ViewBag.HasActiveMfaCode == true)
                            {
                                @:A verification code was already sent to <strong>@ViewBag.EmailHint</strong>. Enter it below, or request a new one.
                            }
                            else if (ViewBag.ShouldSendMfaOnLoad == true)
                            {
                                @:Sending a verification code to <strong>@ViewBag.EmailHint</strong>...
                            }
                            else
                            {
                                @:Enter the 6-digit verification code sent to <strong>@ViewBag.EmailHint</strong>.
                            }
                        </span>
                    </div>

                    @using (Html.BeginForm("VerifyMFA", "Account", new { tenant = tenantToken }, FormMethod.Post, new { id = "mfaVerifyForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="login-field-group mb-4">
                            <label for="code">Verification code</label>
                            <div class="login-input-wrap">
                                <span class="login-input-icon"><i class="fas fa-key"></i></span>
                                <input class="login-input mfa-verify-code-input"
                                       id="code" name="code" type="text" maxlength="6"
                                       placeholder="000000" required autocomplete="off" autofocus />
                            </div>
                        </div>

                        <div class="auth-login-actions mt-4">
                            <button type="submit" class="btn-primary-mfa" id="btnSubmit">
                                <i class="fas fa-check-circle mr-2"></i> Verify &amp; sign in
                            </button>
                        </div>
                    }

                    <div class="mt-4 text-center">
                        <p class="text-muted small mb-2 font-weight-bold">Didn't receive the code?</p>
                        <button type="button" id="btnResend" class="btn btn-outline-primary btn-sm rounded-pill font-weight-bold px-4 py-2 mt-1 shadow-sm" style="border-width: 2px;">
                            <i class="fas fa-sync-alt mr-1"></i> Resend verification code
                        </button>
                    </div>
                </div>

                <div class="mfa-footer auth-login-footer">
                    <a href="@Url.Action("Logout", "Account", new { tenant = tenantToken })" class="btn-link-mfa">
                        <i class="fas fa-arrow-left mr-1"></i> Return to login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            $('#code').focus();

            $('#mfaVerifyForm').submit(function() {
                var btn = $('#btnSubmit')[0];
                if (!btn) {
                    return;
                }
                while (btn.firstChild) {
                    btn.removeChild(btn.firstChild);
                }
                btn.disabled = true;
                var icon = document.createElement('i');
                icon.className = 'fas fa-spinner fa-spin mr-2';
                btn.appendChild(icon);
                btn.appendChild(document.createTextNode(' Verifying...'));
            });

            var resendUrl = '@Url.Action("ResendCode", "Account", new { tenant = tenantToken })';
            var emailHint = '@ViewBag.EmailHint';

            function setMfaStatus(type, message) {
                var status = $('#mfaSendStatus');
                var text = $('#mfaSendStatusText');
                status.removeClass('alert-info alert-success alert-warning alert-danger');
                if (type === 'success') {
                    status.addClass('alert-success');
                } else if (type === 'error') {
                    status.addClass('alert-danger');
                } else if (type === 'pending') {
                    status.addClass('alert-info');
                } else {
                    status.addClass('alert-warning');
                }
                text.html(message);
            }

            function sendMfaCode(triggerButton) {
                var btn = triggerButton ? $(triggerButton) : null;
                var originalHtml = btn ? btn.html() : null;

                if (btn) {
                    btn.prop('disabled', true);
                    btn.html('<i class="fas fa-spinner fa-spin mr-1"></i> Sending...');
                }

                setMfaStatus('pending', 'Sending a verification code to <strong>' + emailHint + '</strong>. This can take up to 15 seconds...');

                $.ajax({
                    url: resendUrl,
                    method: 'POST',
                    data: {
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                    },
                    dataType: 'json',
                    timeout: 60000
                }).done(function(re) {
                    if (re && re.success) {
                        setMfaStatus('success', 'A new verification code was sent to <strong>' + emailHint + '</strong>. Check your inbox and spam folder, then enter the code below.');
                    } else {
                        setMfaStatus('error', (re && re.message) ? re.message : 'Failed to send verification email. Check SMTP settings or try again.');
                    }
                }).fail(function(xhr, textStatus) {
                    if (textStatus === 'timeout') {
                        setMfaStatus('error', 'Sending timed out. Check your network connection and try again.');
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        setMfaStatus('error', xhr.responseJSON.message);
                    } else {
                        setMfaStatus('error', 'Could not reach the server. Refresh the page and try again.');
                    }
                }).always(function() {
                    if (btn) {
                        btn.prop('disabled', false);
                        btn.html(originalHtml);
                    }
                });
            }

            $('#btnResend').on('click', function() {
                sendMfaCode(this);
            });

            @if (ViewBag.ShouldSendMfaOnLoad == true)
            {
                <text>sendMfaCode(null);</text>
            }
        });
    </script>
}
