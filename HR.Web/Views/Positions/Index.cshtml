        background: rgba(108, 117, 125, 0.12);
        color: #5a6268;
        border: 1px solid rgba(108, 117, 125, 0.25);
    }
    .position-viewed-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        margin-left: 0.35rem;
        vertical-align: middle;
