@if (trackCandidateViews)
{
    <div id="positionViewAntiForgery" class="d-none">
        @Html.AntiForgeryToken()
    </div>
}

@section Scripts {
    <script>
        window.hrTrackCandidateViews = @(trackCandidateViews ? "true" : "false");
        window.hrRecordCandidateViewUrl = '@Url.Action("RecordCandidateView", "Positions")';
        (function () {
            // Wait for DOM and jQuery to be ready
            if (typeof jQuery === 'undefined') {
                console.error('jQuery is not loaded');
                return;
            }

            jQuery(document).ready(function ($) {
                var items = document.querySelectorAll('.position-item');
                var title = document.getElementById('posTitle');
                var dept = document.getElementById('posDept');
                var posted = document.getElementById('posPosted');
                var expiry = document.getElementById('posExpiry');
                var range = document.getElementById('posRange');
                var detail = document.getElementById('positionDetail');
                var linkEdit = document.getElementById('posEdit');
                var linkDelete = document.getElementById('posDelete');
                var linkApply = document.getElementById('posApply');
                var linkViewApplications = document.getElementById('posViewApplications');
                var linkQuestionWeights = document.getElementById('posQuestionWeights');
                var appliedStatus = document.getElementById('posAppliedStatus');
                var modalAppliedStatus = document.getElementById('modalPosAppliedStatus');
                var positionModal = document.getElementById('positionModal');
                var modalTitle = document.getElementById('modalPosTitle');
                var modalDesc = document.getElementById('modalPosDesc');
                var modalResponsibilities = document.getElementById('modalPosResponsibilities');
                var modalResponsibilitiesContent = document.getElementById('modalPosResponsibilitiesContent');
                var modalQualifications = document.getElementById('modalPosQualifications');
                var modalQualificationsContent = document.getElementById('modalPosQualificationsContent');
                var modalDept = document.getElementById('modalPosDept');
                var modalPosted = document.getElementById('modalPosPosted');
                var modalExpiry = document.getElementById('modalPosExpiry');
                var modalRange = document.getElementById('modalPosRange');
                var modalEdit = document.getElementById('modalEdit');
                var modalDelete = document.getElementById('modalDelete');
                var modalApply = document.getElementById('modalApply');
                var modalViewApplications = document.getElementById('modalViewApplications');
                var modalQuestionWeights = document.getElementById('modalQuestionWeights');
                var compactLayoutQuery = window.matchMedia('(max-width: 991.98px)');

                if (!positionModal) {
                    console.error('Position modal not found');
                    return;
                }

                if (!title || !dept || !posted || !range || !detail) {
                    console.error('Required DOM elements not found');
                    return;
                }

                function usesCompactPositionLayout() {
                    return compactLayoutQuery.matches;
                }

                function populateModal(src) {
                    if (!src) return;
                    if (modalTitle) modalTitle.textContent = src.getAttribute('data-title') || '';
                    var descText = src.getAttribute('data-desc') || '';
                    if (modalDesc) {
                        modalDesc.textContent = descText || 'No description provided.';
                        modalDesc.style.display = descText ? 'block' : 'none';
                    }
                    var respText = src.getAttribute('data-responsibilities') || '';
                    if (modalResponsibilities && modalResponsibilitiesContent) {
                        if (respText) {
                            modalResponsibilitiesContent.textContent = respText;
                            modalResponsibilities.style.display = 'block';
                        } else {
                            modalResponsibilities.style.display = 'none';
                        }
                    }
                    var qualText = src.getAttribute('data-qualifications') || '';
                    if (modalQualifications && modalQualificationsContent) {
                        if (qualText) {
                            modalQualificationsContent.textContent = qualText;
                            modalQualifications.style.display = 'block';
                        } else {
                            modalQualifications.style.display = 'none';
                        }
                    }
                    if (modalDept) modalDept.textContent = src.getAttribute('data-dept') || '';
                    if (modalPosted) modalPosted.textContent = src.getAttribute('data-posted') || '';
                    if (modalExpiry) modalExpiry.textContent = src.getAttribute('data-expiry') || '';
                    if (modalRange) modalRange.textContent = src.getAttribute('data-range') || '';
                    if (modalEdit) modalEdit.href = src.getAttribute('data-url-edit') || '#';
                    if (modalDelete) modalDelete.href = src.getAttribute('data-url-delete') || '#';
                    if (modalApply) updateCandidateActionLink(modalApply, src);
                    if (modalViewApplications) modalViewApplications.href = src.getAttribute('data-url-applications') || '#';
                    if (modalQuestionWeights) modalQuestionWeights.href = src.getAttribute('data-url-question-weights') || '#';
                    renderAppliedStatus(src, modalAppliedStatus);
                }

                function openPositionModal(src) {
                    if (!src || !positionModal) return;
                    populateModal(src);
                    var $modal = $('#positionModal');
                    if ($modal.length && typeof $modal.modal === 'function') {
                        $modal.modal('show');
                        return;
                    }
                    positionModal.classList.add('show');
                    positionModal.style.display = 'block';
                    positionModal.removeAttribute('aria-hidden');
                    document.body.classList.add('modal-open');
                }

                function renderAppliedStatus(el, statusEl) {
                    if (!statusEl) return;
                    var hasApplied = el && el.getAttribute('data-has-applied') === 'true';
                    if (!hasApplied) {
                        statusEl.classList.remove('is-visible');
                        statusEl.innerHTML = '';
                        return;
                    }

                    var badgeLabel = el.getAttribute('data-applied-badge-label') || 'Applied';
                    var badgeClass = el.getAttribute('data-applied-badge-class') || 'position-applied-badge--applied';
                    var appliedOn = el.getAttribute('data-applied-on') || '';
                    var appliedMeta = appliedOn ? ' &middot; Submitted ' + appliedOn : '';

                    statusEl.className = 'is-visible';
                    statusEl.style.background = '';
                    statusEl.style.color = '';
                    statusEl.style.border = '';

                    if (badgeClass.indexOf('--action') !== -1) {
                        statusEl.style.background = 'rgba(196, 122, 23, 0.12)';
                        statusEl.style.color = '#8a5310';
                        statusEl.style.border = '1px solid rgba(196, 122, 23, 0.28)';
                    } else if (badgeClass.indexOf('--hired') !== -1) {
                        statusEl.style.background = 'rgba(40, 167, 69, 0.12)';
                        statusEl.style.color = '#1d6b32';
                        statusEl.style.border = '1px solid rgba(40, 167, 69, 0.28)';
                    } else if (badgeClass.indexOf('--offer') !== -1) {
                        statusEl.style.background = 'rgba(111, 66, 193, 0.12)';
                        statusEl.style.color = '#5b2f9e';
                        statusEl.style.border = '1px solid rgba(111, 66, 193, 0.28)';
                    } else if (badgeClass.indexOf('--closed') !== -1) {
                        statusEl.style.background = 'rgba(108, 117, 125, 0.1)';
                        statusEl.style.color = '#5a6268';
                        statusEl.style.border = '1px solid rgba(108, 117, 125, 0.22)';
                    } else if (badgeClass.indexOf('--review') !== -1) {
                        statusEl.style.background = 'rgba(61, 143, 173, 0.12)';
                        statusEl.style.color = '#2a6f87';
                        statusEl.style.border = '1px solid rgba(61, 143, 173, 0.28)';
                    } else {
                        statusEl.style.background = 'rgba(46, 125, 96, 0.12)';
                        statusEl.style.color = '#1f5c45';
                        statusEl.style.border = '1px solid rgba(46, 125, 96, 0.28)';
                    }

                    statusEl.innerHTML = '<i class="fas fa-check-circle mr-1"></i> You applied here' + appliedMeta + ' &mdash; <strong>' + badgeLabel + '</strong>';
                }

                function updateAppliedStatus(el) {
                    renderAppliedStatus(el, appliedStatus);
                }

                function updateCandidateActionLink(linkEl, el) {
                    if (!linkEl || !el) return;
                    var actionUrl = el.getAttribute('data-candidate-action-url') || el.getAttribute('data-url-apply') || '#';
                    var actionLabel = el.getAttribute('data-candidate-action-label');
                    var actionIcon = el.getAttribute('data-candidate-action-icon') || 'fas fa-paper-plane';
                    linkEl.href = actionUrl;
                    if (actionLabel) {
                        linkEl.innerHTML = '<i class="' + actionIcon + '"></i> ' + actionLabel;
                    }
                }

                function isMobileViewport() {
                    return usesCompactPositionLayout();
                }

                function makeActive(el) {
                    if (!el) return;
                    items.forEach(function (i) { i.classList.remove('active'); });
                    el.classList.add('active');
                    if (title) title.textContent = el.getAttribute('data-title') || '';
                    if (dept) dept.textContent = el.getAttribute('data-dept') || '';
                    if (posted) posted.textContent = el.getAttribute('data-posted') || '';
                    if (expiry) expiry.textContent = el.getAttribute('data-expiry') || '';
                    if (range) range.textContent = el.getAttribute('data-range') || '';
                    if (linkEdit) { linkEdit.href = el.getAttribute('data-url-edit') || '#'; }
                    if (linkDelete) { linkDelete.href = el.getAttribute('data-url-delete') || '#'; }
                    if (linkApply) { updateCandidateActionLink(linkApply, el); }
                    if (linkViewApplications) { linkViewApplications.href = el.getAttribute('data-url-applications') || '#'; }
                    if (linkQuestionWeights) { linkQuestionWeights.href = el.getAttribute('data-url-question-weights') || '#'; }
                    updateAppliedStatus(el);
                    if (detail && !usesCompactPositionLayout()) {
                        detail.style.display = '';
                    } else if (detail) {
                        detail.style.display = 'none';
                    }
                }

                function recordCandidatePositionView(el) {
                    if (!el || !window.hrTrackCandidateViews) return;
                    if (el.getAttribute('data-has-applied') === 'true') return;
                    var positionId = el.getAttribute('data-position-id');
                    var tokenInput = document.querySelector('#positionViewAntiForgery input[name="__RequestVerificationToken"]');
                    if (!positionId || !tokenInput || !tokenInput.value) return;
                    var body = 'positionId=' + encodeURIComponent(positionId) +
                        '&__RequestVerificationToken=' + encodeURIComponent(tokenInput.value);
                    if (window.fetch) {
                        window.fetch(window.hrRecordCandidateViewUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                            body: body,
                            credentials: 'same-origin'
                        });
                        return;
                    }
                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', window.hrRecordCandidateViewUrl, true);
                    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
                    xhr.send(body);
                }

                function handlePositionSelect(el, e) {
                    if (e) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    makeActive(el);
                    recordCandidatePositionView(el);
                    if (usesCompactPositionLayout()) {
                        openPositionModal(el);
                    }
                }

                items.forEach(function (el) {
                    el.addEventListener('click', function (e) { handlePositionSelect(el, e); });
                    el.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                            handlePositionSelect(el, e);
                        }
                    });
                });

                var cardView = document.getElementById('posViewDetails');
                if (cardView) {
                    cardView.addEventListener('click', function () {
                        var active = document.querySelector('.position-item.active');
                        if (!active) return;
                        openPositionModal(active);
                    });
                }

                // Admin filter functionality
                var filterAll = document.getElementById('filterAll');
                var filterOpen = document.getElementById('filterOpen');
                var filterClosed = document.getElementById('filterClosed');
                
                if (filterAll && filterOpen && filterClosed) {
                    function setActiveFilter(activeBtn) {
                        [filterAll, filterOpen, filterClosed].forEach(function(btn) {
                            btn.classList.remove('active');
                        });
                        activeBtn.classList.add('active');
                    }
                    
                    function filterPositions(filterType) {
                        var items = document.querySelectorAll('.position-item');
                        items.forEach(function(item) {
                            var isOpen = item.getAttribute('data-is-open') === 'true';
                            var show = false;
                            
                            switch(filterType) {
                                case 'all':
                                    show = true;
                                    break;
                                case 'open':
                                    show = isOpen;
                                    break;
                                case 'closed':
                                    show = !isOpen;
                                    break;
                            }
                            
                            item.style.display = show ? '' : 'none';
                        });
                        
                        // Update detail card visibility
                        var detail = document.getElementById('positionDetail');
                        if (detail) {
                            var visibleItems = Array.from(items).filter(function(item) {
                                return item.style.display !== 'none';
                            });
                            if (visibleItems.length === 0) {
                                detail.style.display = 'none';
                            }
                        }
                    }
                    
                    filterAll.addEventListener('click', function() {
                        setActiveFilter(filterAll);
                        filterPositions('all');
                    });
                    
                    filterOpen.addEventListener('click', function() {
                        setActiveFilter(filterOpen);
                        filterPositions('open');
                    });
                    
                    filterClosed.addEventListener('click', function() {
                        setActiveFilter(filterClosed);
                        filterPositions('closed');
                    });
                }
            });
        })();
    </script>
}
