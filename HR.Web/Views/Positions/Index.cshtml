        color: #0d47a1;
        border: 1px solid rgba(13, 71, 161, 0.28);
    }
    .position-applied-meta {
        font-size: 0.78rem;
        color: #2e7d60;
        font-weight: 500;
        margin-top: 0.35rem;
    }
    .position-applied-meta i {
        opacity: 0.85;
    }
    #posAppliedStatus,
    #modalPosAppliedStatus {
        display: none;
        margin-bottom: 0.85rem;
        padding: 0.55rem 0.75rem;
        border-radius: 0.4rem;
        font-size: 0.88rem;
        font-weight: 500;
    }
    #posAppliedStatus.is-visible,
    #modalPosAppliedStatus.is-visible {
        display: block;
    }
    @@keyframes applied-badge-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(196, 122, 23, 0.35); }
        50% { box-shadow: 0 0 0 4px rgba(196, 122, 23, 0); }
    }
    .text-truncate { 
        white-space: nowrap; 
        overflow: hidden; 
        text-overflow: ellipsis; 
    }
    .list-group {
        background: transparent;
        border: none;
    }
    .card-title, h4, h5 {
        color: #0d2c4a;
        font-weight: 600;
    }
    .btn-blue {
        background: #6fb8dc;
        color: #0d2c4a;
        border: none;
        transition: background 0.2s;
        font-size: 0.97rem;
        padding: 0.5rem 1.2rem;
        border-radius: 0.4rem;
        font-weight: 600;
    }
    .btn-blue:hover {
        background: #3498db;
        color: #fff;
    }
    .btn-primary {
        background: #6fb8dc;
        color: #0d2c4a;
        border: none;
        transition: background 0.2s;
    }
    .btn-primary:hover {
        background: #3498db;
        color: #fff;
    }
    .btn-outline-primary {
        border-color: #6fb8dc;
        color: #6fb8dc;
    }
    .btn-outline-primary:hover {
        background: #6fb8dc;
        color: #0d2c4a;
    }
    .text-muted {
        color: #6c757d !important;
    }
    .modal-content {
        border-radius: 0.4rem;
    }
    .modal-header {
        background: #f6faff;
        border-bottom: 1px solid #e6f3fb;
    }
    .modal-body {
        background: #fafdff;
    }
    .modal-footer {
        background: #f6faff;
        border-top: 1px solid #e6f3fb;
    }
    .gap-2 {
        gap: 0.5rem;
    }
    .d-flex.gap-2 {
        display: flex;
        flex-wrap: wrap;
    }

    @@media (max-width: 991.98px) {
        .position-item .d-flex.w-100.justify-content-between {
            flex-direction: column;
            gap: 0.5rem;
        }

        .position-item .text-right.ml-3 {
            margin-left: 0 !important;
            text-align: left;
        }

        .position-item::after {
            content: "Tap for details";
            display: block;
            margin-top: 0.35rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--app-accent-deep, #3d8fad);
        }

        /* Sidebar actions sit below the list on tablets/phones; modal replaces them */
        .positions-detail-column,
        #positionDetail {
            display: none !important;
        }

        #positionModal .modal-dialog {
            margin: 0.5rem;
            max-width: calc(100% - 1rem);
        }

        #positionModal .modal-content {
            max-height: calc(100vh - 1rem);
            display: flex;
            flex-direction: column;
        }

        #positionModal .modal-body {
            overflow-y: auto;
        }

        #positionModal .modal-footer {
            position: sticky;
            bottom: 0;
            z-index: 2;
            flex-wrap: nowrap;
            gap: 0.5rem;
        }

        #positionModal .modal-footer .btn {
            flex: 1 1 0;
            min-width: 0;
        }
    }
</style>

@if (ViewBag.IsSuperAdmin == true && ViewBag.IsReadOnly == true)
{
    <div class="mb-4 d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-sm border-left border-primary positions-sa-bar" style="border-left-width: 4px !important;">
        <div>
            <h4 class="mb-1">Positions for <span class="text-primary">@ViewBag.SelectedCompanyName</span></h4>
            <p class="text-muted mb-0 small"><i class="fas fa-info-circle"></i> Companies Management View: Read-only access to all positions.</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" id="switchCompanyDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fas fa-building mr-1"></i> Switch Company
            </button>
            <div class="dropdown-menu dropdown-menu-right shadow-sm border-0" aria-labelledby="switchCompanyDropdown" style="max-height: 300px; overflow-y: auto;">
                <a class="dropdown-item @(ViewBag.SelectedCompanyId == null ? "active" : "")" href="@Url.Action("Index", "Positions", new { companyId = (int?)null })">
                    <strong>All Companies</strong>
                </a>
                <div class="dropdown-divider"></div>
                @if (ViewBag.AllCompanies != null)
                {
                    foreach (var company in ViewBag.AllCompanies)
                    {
                        <a class="dropdown-item @(ViewBag.SelectedCompanyId == company.Id ? "active font-weight-bold" : "")" href="@Url.Action("Index", "Positions", new { companyId = company.Id })">
                            @company.Name
                        </a>
                    }
                }
            </div>
        </div>
    </div>
}

@if (isAdmin)
{
    <div class="mb-3 positions-admin-toolbar">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center w-100">
            <div>
                <a class="btn btn-blue" href="@Url.Action("Create", "Positions")">
                    <i class="fas fa-plus"></i> New Position
                </a>
            </div>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-secondary active" id="filterAll">
                    <i class="fas fa-list"></i> All Positions
                </button>
                <button type="button" class="btn btn-success" id="filterOpen">
                    <i class="fas fa-unlock"></i> Open Only
                </button>
                <button type="button" class="btn btn-secondary" id="filterClosed">
                    <i class="fas fa-lock"></i> Closed Only
                </button>
            </div>
        </div>
    </div>
}
else if (!Request.IsAuthenticated)
{
    <div class="mb-4 bg-white p-3 rounded shadow-sm border-left border-info" style="border-left-width: 4px !important;">
        <h4 class="mb-1"><i class="fas fa-globe mr-2"></i> Public Careers Portal</h4>
        <p class="text-muted mb-0">Browse open opportunities across our network. You will be prompted to sign in or create an account when applying.</p>
    </div>
}

@if (!displayPositions.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> @(isAdmin ? "No positions found." : "No positions available at this time.")
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8 col-12">
            <div class="list-group">
                @foreach (var p in displayPositions)
                {
                    PositionCandidateActionViewModel candidateAction;
                    if (!candidateActionsByPositionId.TryGetValue(p.Id, out candidateAction))
                    {
                        candidateAction = PositionCandidateActionHelper.Resolve(Request.IsAuthenticated, null, p, Url);
                    }
                    var itemClasses = "list-group-item list-group-item-action position-item";
                    if (candidateAction != null && candidateAction.HasApplied)
                    {
                        itemClasses += " position-item--applied";
                        if (candidateAction.BadgeCssClass == "position-applied-badge--action")
                        {
                            itemClasses += " position-item--action";
                        }
                    }
                    <a class="@itemClasses"
                       href="#"
                       role="button"
                       tabindex="0"
                       data-position-id="@p.Id"
                       data-title="@p.Title"
                       data-desc="@(p.Description ?? "")"
                       data-responsibilities="@getResponsibilities(p)"
                       data-qualifications="@getQualifications(p)"
                       data-dept="@(p.Department != null ? p.Department.Name : "")"
                       data-posted="@p.PostedOn.ToShortDateString()"
                       data-expiry="@(p.ExpiryDate.HasValue ? p.ExpiryDate.Value.ToShortDateString() : "No expiry date set")"
                       data-range="@(p.SalaryMin.HasValue && p.SalaryMax.HasValue ? formatSalary(p, p.SalaryMin) + " - " + formatSalary(p, p.SalaryMax) : "Salary Varies")"
                       data-is-open="@p.IsOpen.ToString().ToLower()"
                       data-url-edit="@Url.Action("Edit", "Positions", new { id = p.Id })"
                       data-url-delete="@Url.Action("Delete", "Positions", new { id = p.Id })"
                       data-url-question-weights="@string.Format("{0}#questionWeightPanel", Url.Action("Edit", "Positions", new { id = p.Id }))"
                       data-url-apply="@candidateAction.Url"
                       data-candidate-action-url="@candidateAction.Url"
                       data-candidate-action-label="@candidateAction.Label"
                       data-candidate-action-icon="@candidateAction.IconClass"
                       data-has-applied="@(candidateAction.HasApplied ? "true" : "false")"
                       data-applied-badge-label="@(candidateAction.BadgeLabel ?? "")"
                       data-applied-badge-class="@(candidateAction.BadgeCssClass ?? "")"
                       data-applied-on="@(candidateAction.AppliedOn.HasValue ? candidateAction.AppliedOn.Value.ToString("MMM d, yyyy") : "")"
                       data-url-applications="@Url.Action("Index", "Applications", new { positionId = p.Id })#appsCards-@p.Id">
                        <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                            <div class="flex-grow-1">
                                <h5 class="mb-1">
                                    @p.Title
                                    @if (candidateAction.HasApplied)
                                    {
                                        var appliedBadgeLabel = string.IsNullOrEmpty(candidateAction.BadgeLabel) ? "Applied" : candidateAction.BadgeLabel;
                                        var appliedBadgeClass = string.IsNullOrEmpty(candidateAction.BadgeCssClass) ? "position-applied-badge--applied" : candidateAction.BadgeCssClass;
                                        <span class="position-applied-badge @appliedBadgeClass">
                                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                                            @appliedBadgeLabel
                                        </span>
                                    }
                                    else if (candidateAction.ShowRecentlyViewed)
                                    {
                                        <span class="position-viewed-badge">
                                            <i class="fas fa-eye" aria-hidden="true"></i>
                                            Recently viewed
                                        </span>
                                    }
                                </h5>
                                <small class="text-muted d-block">@(p.Department != null ? p.Department.Name : "No Department")</small>
                                @if (candidateAction.HasApplied && candidateAction.AppliedOn.HasValue)
                                {
                                    <div class="position-applied-meta">
                                        <i class="fas fa-paper-plane mr-1" aria-hidden="true"></i>
                                        Submitted @candidateAction.AppliedOn.Value.ToString("MMM d, yyyy")
                                    </div>
                                }
                                @if (!Request.IsAuthenticated || (ViewBag.IsSuperAdmin == true && ViewBag.SelectedCompanyId == null))
                                {
                                    <small class="text-info d-block" style="font-size: 0.85em; margin-top: 2px;">
                                        <i class="fas fa-building"></i> @(p.Company != null ? p.Company.Name : "Unknown Company")
                                    </small>
                                }
                            </div>
                            <div class="text-right ml-3">
                                <span class="badge badge-@(p.IsOpen ? "success" : "secondary") mb-1">
                                    @(p.IsOpen ? "Open" : "Closed")
                                </span>
                                <br/>
                                <small class="text-muted d-block">@p.PostedOn.ToShortDateString()</small>
                                @if (p.SalaryMin.HasValue)
                                {
                                    <small class="text-muted d-block">@formatSalary(p, p.SalaryMin)</small>
                                }
                            </div>
                        </div>
                        <p class="mb-2">@(string.IsNullOrEmpty(p.Description) ? "No description available." : (p.Description.Length > 150 ? p.Description.Substring(0, 150) + "..." : p.Description))</p>
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-4 positions-detail-column d-none d-lg-block">
            <div id="positionDetail" class="pos-detail-card" style="display:none;">
                <div id="posAppliedStatus" role="status" aria-live="polite"></div>
                <h4 id="posTitle" class="mb-3"></h4>
                <p class="text-muted mb-2" id="posDept"></p>
                <p class="mb-2"><strong>Posted:</strong> <span id="posPosted"></span></p>
                <p class="mb-2"><strong>Expiry:</strong> <span id="posExpiry"></span></p>
                <p class="mb-3"><strong>Salary:</strong> <span id="posRange"></span></p>
                <div class="d-flex flex-wrap gap-2">
@* Conditional sidebar action buttons for admin/user on details card *@
@if (isAdmin)
{
    <a id="posEdit" class="btn btn-sm btn-secondary" href="#">
        <i class="fas fa-edit"></i> Edit
    </a>
    <a id="posViewApplications" class="btn btn-sm btn-warning" href="#">
        <i class="fas fa-list-ul"></i> View Applications
    </a>
    <a id="posQuestionWeights" class="btn btn-sm btn-outline-primary" href="#">
        <i class="fas fa-sliders-h"></i> Question Weights
    </a>
    <a id="posDelete" class="btn btn-sm btn-danger" href="#">
        <i class="fas fa-trash"></i> Delete
    </a>
}
else if (ViewBag.IsReadOnly != true)
{
    <a id="posApply" class="btn btn-sm btn-blue" href="#">
        <i class="fas fa-paper-plane"></i> @(Request.IsAuthenticated ? "Apply" : "Sign In to Apply")
    </a>
}
                    <button id="posViewDetails" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye"></i> View Details
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Modals {
<!-- Modal lives outside .app-page so Bootstrap backdrop stacks correctly -->
<div class="modal fade" id="positionModal" tabindex="-1" role="dialog" aria-labelledby="positionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalPosTitle">Position</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div id="modalPosAppliedStatus" role="status" aria-live="polite"></div>
        <p class="text-muted mb-2" id="modalPosDept"></p>
        <div id="modalPosDesc" class="mb-3"></div>
        <div id="modalPosResponsibilities" class="mb-3" style="display:none;">
          <strong class="d-block mb-2" style="color: #0d2c4a;">Key Responsibilities:</strong>
          <div id="modalPosResponsibilitiesContent" style="white-space: pre-line; line-height: 1.8; color: #333;"></div>
        </div>
        <div id="modalPosQualifications" class="mb-3" style="display:none;">
          <strong class="d-block mb-2" style="color: #0d2c4a;">Required Qualifications:</strong>
          <div id="modalPosQualificationsContent" style="white-space: pre-line; line-height: 1.8; color: #333;"></div>
        </div>
        <p class="mb-2"><strong>Posted:</strong> <span id="modalPosPosted"></span></p>
        <p class="mb-2"><strong>Expiry:</strong> <span id="modalPosExpiry"></span></p>
        <p class="mb-2"><strong>Salary:</strong> <span id="modalPosRange"></span></p>
      </div>
      <div class="modal-footer">
@if (isAdmin)
{
    <a id="modalEdit" class="btn btn-secondary" href="#">
        <i class="fas fa-edit"></i> Edit
    </a>
    <a id="modalViewApplications" class="btn btn-warning" href="#">
        <i class="fas fa-list-ul"></i> View Applications
    </a>
    <a id="modalQuestionWeights" class="btn btn-outline-primary" href="#">
        <i class="fas fa-sliders-h"></i> Question Weights
    </a>
    <a id="modalDelete" class="btn btn-danger" href="#">
        <i class="fas fa-trash"></i> Delete
    </a>
}
else if (ViewBag.IsReadOnly != true)
