@model HR.Web.ViewModels.EmailTemplateManagementViewModel
@using System
@using System.Collections.Generic
@using HR.Web.Helpers
@using HR.Web.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Email Templates";
    ViewBag.SuppressPageHero = true;
    var templates = Model != null && Model.Templates != null
        ? Model.Templates
        : new List<HR.Web.ViewModels.EmailTemplateEditorItemViewModel>();
}
<style>
    .email-template-storage {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
    }
    .email-subject-compose,
    .email-body-compose {
        cursor: text;
        background: #fff;
    }
    .email-subject-compose {
        min-height: 3.25rem;
        white-space: pre-wrap;
    }
    .email-body-compose {
        min-height: 280px;
        overflow-y: auto;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
    }
    .email-body-compose p { margin: 0 0 0.75rem; }
    .email-template-compose {
        transition: box-shadow 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .email-template-compose.email-template-editing {
        border-color: #4a90d9 !important;
        box-shadow: 0 0 0 3px rgba(74, 144, 217, 0.35);
        background-color: #f8fbff !important;
    }
    .email-template-editing-banner {
        display: none;
        border-left: 4px solid #007bff;
    }
    .email-template-compose.email-template-editing .email-template-editing-banner {
        display: block;
    }
    .email-template-format-toolbar .btn {
        min-width: 2.1rem;
    }
    .hr-email-token {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        vertical-align: middle;
        margin: 0 2px;
        padding: 2px 8px;
        border-radius: 6px;
        background: #e8f0fe;
        border: 1px solid #c6dafc;
        font-size: 13px;
        color: #1a3a5c;
        white-space: nowrap;
    }
</style>

@functions {
    private bool ShouldShowTemplateTokenShortcut(string templateKey, string tokenName)
    {
        if (string.IsNullOrWhiteSpace(tokenName))
        {
            return false;
        }

        var normalizedTemplateKey = EmailTemplateCatalog.NormalizeTemplateKey(templateKey);
        if (string.Equals(normalizedTemplateKey, EmailTemplateCatalog.SecondaryStageInvitation, StringComparison.OrdinalIgnoreCase) &&
            (string.Equals(tokenName.Trim(), EmailTemplateCatalog.QuestionnaireStageLinkToken, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(tokenName.Trim(), EmailTemplateCatalog.StageTwoLinkToken, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        return true;
    }
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <div>
            <h2 class="mb-1">Email wording</h2>
            <p class="text-muted mb-0">
                Edit each template's subject and message here. Personalized fields are icon pills, not code.
                Use the formatting toolbar for bold, lists, and links.
            </p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center" style="gap:8px;">
            <a href="@Url.Action("RoleManagement", "Admin")" class="btn btn-outline-secondary">
                <i class="fas fa-user-tag mr-2"></i>Role Templates
            </a>
            @using (Html.BeginForm("SaveEmailTemplates", "Admin", new { tenant = ViewContext.RouteData.Values["tenant"] }, FormMethod.Post, new { @class = "d-inline", id = "resetEmailTemplatesForm", onsubmit = "return confirm('Reset every email template to the built-in defaults? Your current custom wording will be removed (you can edit again afterwards).');" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="resetAllEmailTemplatesToDefaults" value="true" />
                <button type="submit" class="btn btn-outline-danger" id="resetEmailTemplatesBtn" aria-describedby="resetEmailTemplatesHelp">
                    <i class="fas fa-undo-alt mr-2"></i>Reset all to built-in defaults
                </button>
            }
        </div>
    </div>
    <p id="resetEmailTemplatesHelp" class="small text-muted mb-4">
        Use reset to discard every saved customization and reload the system's default subjects and bodies. This cannot be undone, but you can edit templates again after resetting.
    </p>

    <div class="alert alert-light border mb-4">
        <p class="mb-2"><strong>How this works</strong></p>
        <ul class="mb-0 pl-3">
            <li>Use the <strong>round icon buttons</strong> to drop a field into the subject line or the message (hover for a short explanation).</li>
            <li>Fields look like <strong>pills</strong> in the editor - do not delete the pill if you still want that information in the sent email.</li>
            <li><strong>CC</strong> is chosen when someone sends the email, not in this screen.</li>
            <li>Use <strong>Edit</strong> to focus the message editor; <strong>Save</strong> stores all templates on this page.</li>
            <li>While you work, the template shows a blue <strong>Edit mode</strong> banner and border so you always know which one is active.</li>
        </ul>
    </div>

    @using (Html.BeginForm("SaveEmailTemplates", "Admin", new { tenant = ViewContext.RouteData.Values["tenant"] }, FormMethod.Post, new { id = "emailTemplatesForm" }))
    {
        @Html.AntiForgeryToken()

        if (templates.Count == 0)
        {
            <div class="alert alert-info">No email templates are available.</div>
        }

        for (var i = 0; i < templates.Count; i++)
        {
            var defaultSubjectId = "defaultSubjectTemplate_" + i;
            var defaultBodyId = "defaultBodyTemplate_" + i;
            var subjectComposeId = "subjectCompose_" + i;
            var bodyComposeId = "bodyCompose_" + i;
            var tokenSegments = string.IsNullOrWhiteSpace(templates[i].TokenHint)
                ? new string[0]
                : templates[i].TokenHint.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

            <div class="card mb-4 shadow-sm email-template-card">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <h5 class="mb-1">@templates[i].DisplayName</h5>
                            <div class="small text-muted">@templates[i].Category</div>
                            <div class="small text-muted mt-1">@templates[i].Description</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @Html.HiddenFor(m => m.Templates[i].TemplateKey)
                    @Html.HiddenFor(m => m.Templates[i].DisplayName)
                    @Html.HiddenFor(m => m.Templates[i].Description)
                    @Html.HiddenFor(m => m.Templates[i].Category)

                    <div class="email-template-compose border rounded p-3 bg-white"
                         data-subject-compose-id="@subjectComposeId"
                         data-subject-storage-id="@defaultSubjectId"
                         data-body-compose-id="@bodyComposeId"
                         data-body-storage-id="@defaultBodyId"
                         data-body-id="@defaultBodyId">

                        <div class="email-template-editing-banner alert alert-primary mb-3 py-2 px-3" role="status" aria-live="polite">
                            <strong><i class="fas fa-pen mr-2" aria-hidden="true"></i>Edit mode</strong>
                            <span class="d-block small mb-0 mt-1 font-weight-normal">You are editing this template. The highlighted box shows which email you are working on. Click elsewhere on the page to leave edit mode.</span>
                        </div>

                        <h6 class="text-uppercase text-muted small font-weight-bold mb-3">Compose this email</h6>

                        <div class="form-group mb-2">
                            <label class="font-weight-bold d-block mb-1" for="@subjectComposeId">Subject line</label>
                            @Html.TextAreaFor(
                                m => m.Templates[i].DefaultSubjectTemplate,
                                new { id = defaultSubjectId, @class = "email-subject-storage email-template-storage", rows = 3, autocomplete = "off" })
                            <div id="@subjectComposeId"
                                 class="email-subject-compose form-control"
                                 contenteditable="true"
                                 role="textbox"
                                 aria-multiline="true"
                                 data-subject-storage-id="@defaultSubjectId"></div>
                        </div>

                        @if (tokenSegments.Length > 0)
                        {
                            <div class="mb-3">
                                <span class="d-block small font-weight-bold text-muted mb-2">Insert into subject</span>
                                <div class="d-flex flex-wrap align-items-center" style="gap:6px;">
                                    @foreach (var segment in tokenSegments)
                                    {
                                        var tokenName = segment.Trim();
                                        if (tokenName.Length == 0 || !ShouldShowTemplateTokenShortcut(templates[i].TemplateKey, tokenName))
                                        {
                                            continue;
                                        }

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary email-template-token-subj rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width:2.35rem;height:2.35rem;"
                                                data-token-name="@tokenName"
                                                title="@EmailTemplateTokenChipSerializer.AdminTokenHelpText(tokenName)"
                                                aria-label="Insert @EmailTemplateTokenChipSerializer.AdminTokenShortLabel(tokenName) into subject">
                                            <i class="fas @EmailTemplateTokenChipSerializer.AdminTokenIconClass(tokenName)" aria-hidden="true"></i>
                                        </button>
                                        <template class="hr-email-chip-source" data-token-name="@tokenName">@Html.Raw(EmailTemplateTokenChipSerializer.BuildChipHtml(tokenName))</template>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="d-block small font-weight-bold text-muted mb-2">Insert into message</span>
                                <div class="d-flex flex-wrap align-items-center" style="gap:6px;">
                                    @foreach (var segment in tokenSegments)
                                    {
                                        var tokenName = segment.Trim();
                                        if (tokenName.Length == 0 || !ShouldShowTemplateTokenShortcut(templates[i].TemplateKey, tokenName))
                                        {
                                            continue;
                                        }

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary email-template-token-body rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width:2.35rem;height:2.35rem;"
                                                data-token-name="@tokenName"
                                                title="@EmailTemplateTokenChipSerializer.AdminTokenHelpText(tokenName)"
                                                aria-label="Insert @EmailTemplateTokenChipSerializer.AdminTokenShortLabel(tokenName) into message">
                                            <i class="fas @EmailTemplateTokenChipSerializer.AdminTokenIconClass(tokenName)" aria-hidden="true"></i>
                                        </button>
                                        <template class="hr-email-chip-source" data-token-name="@tokenName">@Html.Raw(EmailTemplateTokenChipSerializer.BuildChipHtml(tokenName))</template>
                                    }
                                </div>
                            </div>
                        }

                        <p class="small text-muted border-top pt-3 mb-3">
                            <strong>CC (copy):</strong> Recipients are selected when this email is sent (for example HR). You cannot set fixed CC addresses in this template.
                        </p>

                        <div class="form-group mb-0">
                            <div class="d-flex flex-wrap justify-content-between align-items-start" style="gap:8px;">
                                <div class="flex-grow-1">
                                    <label class="font-weight-bold d-block mb-1" for="@bodyComposeId">Message</label>
                                    <small class="text-muted d-block">What you see here is what recipients get - use Enter for paragraphs; field pills match the sent email.</small>
                                </div>
                                <div class="d-flex flex-shrink-0 align-items-center" style="gap:8px;">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm email-template-edit-btn"
                                            data-body-id="@defaultBodyId"
                                            title="Move focus to this message editor">
                                        <i class="fas fa-edit mr-1" aria-hidden="true"></i>Edit
                                    </button>
                                    <button type="submit"
                                            class="btn btn-success btn-sm"
                                            form="emailTemplatesForm"
                                            title="Save all email templates on this page">
                                        <i class="fas fa-save mr-1" aria-hidden="true"></i>Save
                                    </button>
                                </div>
                            </div>

                            <div class="btn-toolbar email-template-format-toolbar flex-wrap mb-2 mt-2" role="toolbar" aria-label="Message formatting">
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="undo" title="Undo" aria-label="Undo"><i class="fas fa-undo" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="redo" title="Redo" aria-label="Redo"><i class="fas fa-redo" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="bold" title="Bold" aria-label="Bold"><i class="fas fa-bold" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="italic" title="Italic" aria-label="Italic"><i class="fas fa-italic" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="underline" title="Underline" aria-label="Underline"><i class="fas fa-underline" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyLeft" title="Align left" aria-label="Align left"><i class="fas fa-align-left" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyCenter" title="Align center" aria-label="Align center"><i class="fas fa-align-center" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyRight" title="Align right" aria-label="Align right"><i class="fas fa-align-right" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list"><i class="fas fa-list-ul" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list"><i class="fas fa-list-ol" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="createLink" title="Insert link" aria-label="Insert link"><i class="fas fa-link" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="unlink" title="Remove link" aria-label="Remove link"><i class="fas fa-unlink" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting"><i class="fas fa-eraser" aria-hidden="true"></i></button>
                                </div>
                            </div>

                            @Html.TextAreaFor(
                                m => m.Templates[i].DefaultBodyTemplate,
                                new { id = defaultBodyId, @class = "email-template-body-html email-template-storage", rows = 8, autocomplete = "off", maxlength = "200000" })
                            <div id="@bodyComposeId"
                                 class="email-body-compose form-control"
                                 contenteditable="true"
                                 role="textbox"
                                 aria-multiline="true"
                                 data-body-storage-id="@defaultBodyId"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end mb-5">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-save mr-2"></i>Save all template changes
            </button>
        </div>
    }
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/email-template-editor.js")"></script>
}
