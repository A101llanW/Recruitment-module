@model HR.Web.ViewModels.EmailTemplateManagementViewModel
@using System
@using System.Collections.Generic
@using HR.Web.Helpers
@using HR.Web.Services
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Email Templates";
    ViewBag.SuppressPageHero = true;
    var templates = Model != null && Model.Templates != null
        ? Model.Templates
        : new List<HR.Web.ViewModels.EmailTemplateEditorItemViewModel>();
}
<style>
    .email-template-storage {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
    }
    .email-subject-compose,
    .email-body-compose {
        cursor: text;
        background: #fff;
    }
    .email-subject-compose {
        min-height: 3.25rem;
        white-space: pre-wrap;
    }
    .email-body-compose {
        min-height: 280px;
        overflow-y: auto;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
    }
    .email-body-compose p { margin: 0 0 0.75rem; }
    .email-template-compose {
        transition: box-shadow 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .email-template-compose.email-template-editing {
        border-color: #4a90d9 !important;
        box-shadow: 0 0 0 3px rgba(74, 144, 217, 0.35);
        background-color: #f8fbff !important;
    }
    .email-template-editing-banner {
        display: none;
        border-left: 4px solid #007bff;
    }
    .email-template-compose.email-template-editing .email-template-editing-banner {
        display: block;
    }
    .email-template-format-toolbar .btn {
        min-width: 2.1rem;
    }
    .hr-email-token {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        vertical-align: middle;
        margin: 0 2px;
        padding: 2px 8px;
        border-radius: 6px;
        background: #e8f0fe;
        border: 1px solid #c6dafc;
        font-size: 13px;
        color: #1a3a5c;
        white-space: nowrap;
    }
</style>

@functions {
    private bool ShouldShowTemplateTokenShortcut(string templateKey, string tokenName)
    {
        if (string.IsNullOrWhiteSpace(tokenName))
        {
            return false;
        }

        var normalizedTemplateKey = EmailTemplateCatalog.NormalizeTemplateKey(templateKey);
        if (string.Equals(normalizedTemplateKey, EmailTemplateCatalog.SecondaryStageInvitation, StringComparison.OrdinalIgnoreCase) &&
            (string.Equals(tokenName.Trim(), EmailTemplateCatalog.QuestionnaireStageLinkToken, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(tokenName.Trim(), EmailTemplateCatalog.StageTwoLinkToken, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        return true;
    }
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <div>
            <h2 class="mb-1">Email wording</h2>
            <p class="text-muted mb-0">
                Edit each template's subject and message here. Personalized fields are icon pills, not code.
                Use the formatting toolbar for bold and lists.
            </p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap align-items-center" style="gap:8px;">
            <a href="@Url.Action("RoleManagement", "Admin")" class="btn btn-outline-secondary">
                <i class="fas fa-user-tag mr-2"></i>Role Templates
            </a>
            @using (Html.BeginForm("SaveEmailTemplates", "Admin", new { tenant = ViewContext.RouteData.Values["tenant"] }, FormMethod.Post, new { @class = "d-inline", id = "resetEmailTemplatesForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="resetAllEmailTemplatesToDefaults" value="true" />
                <button type="button" class="btn btn-outline-danger" id="resetEmailTemplatesBtn" aria-describedby="resetEmailTemplatesHelp" aria-haspopup="dialog">
                    <i class="fas fa-undo-alt mr-2"></i>Reset all to built-in defaults
                </button>
            }
        </div>
    </div>
    <p id="resetEmailTemplatesHelp" class="small text-muted mb-4">
        Use reset to discard every saved customization and reload the system's default subjects and bodies. This cannot be undone, but you can edit templates again after resetting.
    </p>

    <div class="alert alert-light border mb-4">
        <p class="mb-2"><strong>How this works</strong></p>
        <ul class="mb-0 pl-3">
            <li>Use the <strong>round icon buttons</strong> to drop a field into the subject line or the message (hover for a short explanation).</li>
            <li>Fields look like <strong>pills</strong> in the editor - do not delete the pill if you still want that information in the sent email.</li>
            <li><strong>CC</strong> is chosen when someone sends the email, not in this screen.</li>
            <li>Use <strong>Edit</strong> to focus the message editor; <strong>Save</strong> stores all templates on this page.</li>
            <li>While you work, the template shows a blue <strong>Edit mode</strong> banner and border so you always know which one is active.</li>
        </ul>
    </div>

    @using (Html.BeginForm("SaveEmailTemplates", "Admin", new { tenant = ViewContext.RouteData.Values["tenant"] }, FormMethod.Post, new { id = "emailTemplatesForm" }))
    {
        @Html.AntiForgeryToken()

        if (templates.Count == 0)
        {
            <div class="alert alert-info">No email templates are available.</div>
        }

        for (var i = 0; i < templates.Count; i++)
        {
            var defaultSubjectId = "defaultSubjectTemplate_" + i;
            var defaultBodyId = "defaultBodyTemplate_" + i;
            var subjectComposeId = "subjectCompose_" + i;
            var bodyComposeId = "bodyCompose_" + i;
            var tokenSegments = string.IsNullOrWhiteSpace(templates[i].TokenHint)
                ? new string[0]
                : templates[i].TokenHint.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);

            <div class="card mb-4 shadow-sm email-template-card">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <h5 class="mb-1">@templates[i].DisplayName</h5>
                            <div class="small text-muted">@templates[i].Category</div>
                            <div class="small text-muted mt-1">@templates[i].Description</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @Html.HiddenFor(m => m.Templates[i].TemplateKey)
                    @Html.HiddenFor(m => m.Templates[i].DisplayName)
                    @Html.HiddenFor(m => m.Templates[i].Description)
                    @Html.HiddenFor(m => m.Templates[i].Category)

                    <div class="email-template-compose border rounded p-3 bg-white"
                         data-subject-compose-id="@subjectComposeId"
                         data-subject-storage-id="@defaultSubjectId"
                         data-body-compose-id="@bodyComposeId"
                         data-body-storage-id="@defaultBodyId"
                         data-body-id="@defaultBodyId">

                        <div class="email-template-editing-banner alert alert-primary mb-3 py-2 px-3" role="status" aria-live="polite">
                            <strong><i class="fas fa-pen mr-2" aria-hidden="true"></i>Edit mode</strong>
                            <span class="d-block small mb-0 mt-1 font-weight-normal">You are editing this template. The highlighted box shows which email you are working on. Click elsewhere on the page to leave edit mode.</span>
                        </div>

                        <h6 class="text-uppercase text-muted small font-weight-bold mb-3">Compose this email</h6>

                        <div class="form-group mb-2">
                            <label class="font-weight-bold d-block mb-1" for="@subjectComposeId">Subject line</label>
                            @Html.TextAreaFor(
                                m => m.Templates[i].DefaultSubjectTemplate,
                                new { id = defaultSubjectId, @class = "email-subject-storage email-template-storage", rows = 3, autocomplete = "off" })
                            <div id="@subjectComposeId"
                                 class="email-subject-compose form-control"
                                 contenteditable="true"
                                 role="textbox"
                                 aria-multiline="true"
                                 data-subject-storage-id="@defaultSubjectId"></div>
                        </div>

                        @if (tokenSegments.Length > 0)
                        {
                            <div class="mb-3">
                                <span class="d-block small font-weight-bold text-muted mb-2">Insert into subject</span>
                                <div class="d-flex flex-wrap align-items-center" style="gap:6px;">
                                    @foreach (var segment in tokenSegments)
                                    {
                                        var tokenName = segment.Trim();
                                        if (tokenName.Length == 0 || !ShouldShowTemplateTokenShortcut(templates[i].TemplateKey, tokenName))
                                        {
                                            continue;
                                        }

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary email-template-token-subj rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width:2.35rem;height:2.35rem;"
                                                data-token-name="@tokenName"
                                                title="@EmailTemplateTokenChipSerializer.AdminTokenHelpText(tokenName)"
                                                aria-label="Insert @EmailTemplateTokenChipSerializer.AdminTokenShortLabel(tokenName) into subject">
                                            <i class="fas @EmailTemplateTokenChipSerializer.AdminTokenIconClass(tokenName)" aria-hidden="true"></i>
                                        </button>
                                        <template class="hr-email-chip-source" data-token-name="@tokenName">@Html.Raw(EmailTemplateTokenChipSerializer.BuildChipHtml(tokenName))</template>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="d-block small font-weight-bold text-muted mb-2">Insert into message</span>
                                <div class="d-flex flex-wrap align-items-center" style="gap:6px;">
                                    @foreach (var segment in tokenSegments)
                                    {
                                        var tokenName = segment.Trim();
                                        if (tokenName.Length == 0 || !ShouldShowTemplateTokenShortcut(templates[i].TemplateKey, tokenName))
                                        {
                                            continue;
                                        }

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary email-template-token-body rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                                style="width:2.35rem;height:2.35rem;"
                                                data-token-name="@tokenName"
                                                title="@EmailTemplateTokenChipSerializer.AdminTokenHelpText(tokenName)"
                                                aria-label="Insert @EmailTemplateTokenChipSerializer.AdminTokenShortLabel(tokenName) into message">
                                            <i class="fas @EmailTemplateTokenChipSerializer.AdminTokenIconClass(tokenName)" aria-hidden="true"></i>
                                        </button>
                                        <template class="hr-email-chip-source" data-token-name="@tokenName">@Html.Raw(EmailTemplateTokenChipSerializer.BuildChipHtml(tokenName))</template>
                                    }
                                </div>
                            </div>
                        }

                        <p class="small text-muted border-top pt-3 mb-3">
                            <strong>CC (copy):</strong> Recipients are selected when this email is sent (for example HR). You cannot set fixed CC addresses in this template.
                        </p>

                        <div class="form-group mb-0">
                            <div class="d-flex flex-wrap justify-content-between align-items-start" style="gap:8px;">
                                <div class="flex-grow-1">
                                    <label class="font-weight-bold d-block mb-1" for="@bodyComposeId">Message</label>
                                    <small class="text-muted d-block">What you see here is what recipients get - use Enter for paragraphs; field pills match the sent email.</small>
                                </div>
                                <div class="d-flex flex-shrink-0 align-items-center" style="gap:8px;">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm email-template-edit-btn"
                                            data-body-id="@defaultBodyId"
                                            title="Move focus to this message editor">
                                        <i class="fas fa-edit mr-1" aria-hidden="true"></i>Edit
                                    </button>
                                    <button type="submit"
                                            class="btn btn-success btn-sm"
                                            form="emailTemplatesForm"
                                            title="Save all email templates on this page">
                                        <i class="fas fa-save mr-1" aria-hidden="true"></i>Save
                                    </button>
                                </div>
                            </div>

                            <div class="btn-toolbar email-template-format-toolbar flex-wrap mb-2 mt-2" role="toolbar" aria-label="Message formatting">
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="undo" title="Undo" aria-label="Undo"><i class="fas fa-undo" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="redo" title="Redo" aria-label="Redo"><i class="fas fa-redo" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="bold" title="Bold" aria-label="Bold"><i class="fas fa-bold" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="italic" title="Italic" aria-label="Italic"><i class="fas fa-italic" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="underline" title="Underline" aria-label="Underline"><i class="fas fa-underline" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mr-2 mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyLeft" title="Align left" aria-label="Align left"><i class="fas fa-align-left" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyCenter" title="Align center" aria-label="Align center"><i class="fas fa-align-center" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="justifyRight" title="Align right" aria-label="Align right"><i class="fas fa-align-right" aria-hidden="true"></i></button>
                                </div>
                                <div class="btn-group btn-group-sm mb-1" role="group">
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list"><i class="fas fa-list-ul" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list"><i class="fas fa-list-ol" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-outline-secondary email-template-format-btn" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting"><i class="fas fa-eraser" aria-hidden="true"></i></button>
                                </div>
                            </div>

                            @Html.TextAreaFor(
                                m => m.Templates[i].DefaultBodyTemplate,
                                new { id = defaultBodyId, @class = "email-template-body-html email-template-storage", rows = 8, autocomplete = "off", maxlength = "200000" })
                            <div id="@bodyComposeId"
                                 class="email-body-compose form-control"
                                 contenteditable="true"
                                 role="textbox"
                                 aria-multiline="true"
                                 data-body-storage-id="@defaultBodyId"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end mb-5">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-save mr-2"></i>Save all template changes
            </button>
        </div>
    }
</div>

@section Modals {
<!-- Modal lives outside .app-page so Bootstrap backdrop stacks correctly -->
<div class="modal fade email-workflow-modal" id="resetEmailTemplatesModal" tabindex="-1" role="dialog" aria-labelledby="resetEmailTemplatesModalLabel" aria-describedby="resetEmailTemplatesModalText" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetEmailTemplatesModalLabel">Reset all templates?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="resetEmailTemplatesModalText" class="mb-0">Reset every email template to the built-in defaults? Your current custom wording will be removed. You can edit the templates again afterwards.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="resetEmailTemplatesConfirm">Reset templates</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script src="@Url.Content("~/Scripts/email-workflow-modals.js")"></script>
<script>
(function () {
    var selectionRanges = {};

    function closest(el, selector) {
        if (!el) {
            return el;
        }
        if (el.closest) {
            return el.closest(selector);
        }
        return el;
    }

    function markEmailComposeEditing(compose) {
        if (!compose) {
            return;
        }
        var cards = document.querySelectorAll('.email-template-compose');
        for (var i = 0; i < cards.length; i++) {
            cards[i].classList.toggle('email-template-editing', cards[i] === compose);
        }
    }

    function clearEmailComposeEditing() {
        var editing = document.querySelectorAll('.email-template-compose.email-template-editing');
        for (var i = 0; i < editing.length; i++) {
            editing[i].classList.remove('email-template-editing');
        }
    }

    function enableTemplateStorages() {
        var fields = document.querySelectorAll('#emailTemplatesForm textarea.email-template-storage');
        for (var i = 0; i < fields.length; i++) {
            fields[i].removeAttribute('disabled');
            fields[i].readOnly = false;
            fields[i].classList.remove('readonly-module-disabled');
            fields[i].style.pointerEvents = '';
            fields[i].style.opacity = '';
        }
    }

    function saveSelection(el) {
        if (!el || !el.id) {
            return;
        }
        var sel = window.getSelection ? window.getSelection() : null;
        if (!sel || sel.rangeCount === 0) {
            return;
        }
        var range = sel.getRangeAt(0);
        if (!range) {
            return;
        }
        var container = range.commonAncestorContainer;
        if (container && container.nodeType === 3) {
            container = container.parentNode;
        }
        if (!container || !el.contains(container)) {
            return;
        }
        selectionRanges[el.id] = range.cloneRange();
    }

    function restoreSelection(el) {
        if (!el || !el.id) {
            return false;
        }
        var range = selectionRanges[el.id];
        var sel = window.getSelection ? window.getSelection() : null;
        if (!range || !sel) {
            return false;
        }
        try {
            sel.removeAllRanges();
            sel.addRange(range);
            return true;
        } catch (restoreErr) {
            return false;
        }
    }

    function clearElement(el) {
        while (el && el.firstChild) {
            el.removeChild(el.firstChild);
        }
    }

    function writeComposeHtml(div, html) {
        clearElement(div);
        if (!html) {
            return;
        }
        var parser = new DOMParser();
        var doc = parser.parseFromString('<div>' + html + '</div>', 'text/html');
        var wrapper = doc.body ? doc.body.firstChild : null;
        if (!wrapper) {
            return;
        }
        var imported = div.ownerDocument.importNode(wrapper, true);
        while (imported.firstChild) {
            div.appendChild(imported.firstChild);
        }
    }

    function readComposeHtml(div) {
        if (!div) {
            return '';
        }
        var html = '';
        for (var i = 0; i < div.childNodes.length; i++) {
            var node = div.childNodes[i];
            if (node.nodeType === 1) {
                html += node.outerHTML;
            } else if (node.nodeType === 3) {
                html += node.textContent || '';
            }
        }
        return html;
    }

    function markComposeDirty(composeEl) {
        if (composeEl) {
            composeEl.classList.add('is-dirty');
        }
    }

    function syncComposeToStorage(composeEl) {
        if (!composeEl) {
            return;
        }
        var subjectDiv = document.getElementById(composeEl.getAttribute('data-subject-compose-id'));
        var subjectTa = document.getElementById(composeEl.getAttribute('data-subject-storage-id'));
        if (subjectDiv && subjectTa) {
            subjectTa.value = readComposeHtml(subjectDiv);
        }
        var bodyDiv = document.getElementById(composeEl.getAttribute('data-body-compose-id'));
        var bodyTa = document.getElementById(composeEl.getAttribute('data-body-storage-id'));
        if (bodyDiv && bodyTa) {
            bodyTa.value = readComposeHtml(bodyDiv);
        }
    }

    function syncAllStorages() {
        enableTemplateStorages();
        var composeCards = document.querySelectorAll('.email-template-compose');
        for (var i = 0; i < composeCards.length; i++) {
            if (!composeCards[i].classList.contains('is-dirty')) {
                continue;
            }
            syncComposeToStorage(composeCards[i]);
        }
    }

    function cloneChipNodeFromButton(btn) {
        if (!btn) {
            return btn;
        }
        var tpl = btn.nextElementSibling;
        if (tpl && tpl.tagName && tpl.tagName.toUpperCase() === 'TEMPLATE' && tpl.content && tpl.content.firstElementChild) {
            return tpl.content.firstElementChild.cloneNode(true);
        }
        var tokenName = btn.getAttribute('data-token-name');
        var compose = closest(btn, '.email-template-compose');
        if (!tokenName || !compose) {
            return null;
        }
        var templates = compose.querySelectorAll('template.hr-email-chip-source');
        for (var i = 0; i < templates.length; i++) {
            if (templates[i].getAttribute('data-token-name') === tokenName &&
                templates[i].content &&
                templates[i].content.firstElementChild) {
                return templates[i].content.firstElementChild.cloneNode(true);
            }
        }
        return null;
    }

    function insertNodeAtSelection(container, node) {
        container.focus();
        restoreSelection(container);
        var sel = window.getSelection ? window.getSelection() : null;
        if (sel && sel.rangeCount > 0) {
            var range = sel.getRangeAt(0);
            if (container.contains(range.commonAncestorContainer) || container === range.commonAncestorContainer) {
                range.deleteContents();
                range.insertNode(node);
                range.setStartAfter(node);
                range.collapse(true);
                sel.removeAllRanges();
                sel.addRange(range);
                return;
            }
        }
        container.appendChild(node);
    }

    function insertChipIntoEditor(compose, btn, targetAttr) {
        var chipNode = cloneChipNodeFromButton(btn);
        if (!chipNode || !compose) {
            return;
        }
        var editor = document.getElementById(compose.getAttribute(targetAttr));
        if (!editor) {
            return;
        }
        markEmailComposeEditing(compose);
        markComposeDirty(compose);
        editor.focus();
        restoreSelection(editor);
        var inserted = false;
        try {
            inserted = document.execCommand('insertHTML', false, chipNode.outerHTML);
        } catch (insertErr) {
            inserted = false;
        }
        if (!inserted) {
            insertNodeAtSelection(editor, chipNode.cloneNode(true));
        }
        saveSelection(editor);
        syncComposeToStorage(compose);
    }

    function applyBodyCommand(compose, command, value) {
        var body = document.getElementById(compose.getAttribute('data-body-compose-id'));
        if (!body) {
            return;
        }
        markEmailComposeEditing(compose);
        markComposeDirty(compose);
        body.focus();
        restoreSelection(body);
        try {
            document.execCommand(command, false, value || null);
        } catch (commandErr) {
            return;
        }
        saveSelection(body);
        syncComposeToStorage(compose);
    }

    function bindEditorEvents(div, compose) {
        if (!div) {
            return;
        }
        var events = ['input', 'keyup', 'mouseup', 'focus', 'blur'];
        for (var i = 0; i < events.length; i++) {
            (function (evt) {
                div.addEventListener(evt, function () {
                    saveSelection(div);
                    if (evt === 'input' || evt === 'keyup') {
                        markComposeDirty(compose);
                        syncComposeToStorage(compose);
                    }
                    if (evt === 'focus') {
                        markEmailComposeEditing(compose);
                    }
                });
            })(events[i]);
        }
    }

    function hydrateEditors() {
        var composeCards = document.querySelectorAll('.email-template-compose');
        for (var i = 0; i < composeCards.length; i++) {
            var compose = composeCards[i];
            var subjectDiv = document.getElementById(compose.getAttribute('data-subject-compose-id'));
            var subjectTa = document.getElementById(compose.getAttribute('data-subject-storage-id'));
            if (subjectDiv && subjectTa) {
                writeComposeHtml(subjectDiv, subjectTa.value);
                bindEditorEvents(subjectDiv, compose);
            }
            var bodyDiv = document.getElementById(compose.getAttribute('data-body-compose-id'));
            var bodyTa = document.getElementById(compose.getAttribute('data-body-storage-id'));
            if (bodyDiv && bodyTa) {
                writeComposeHtml(bodyDiv, bodyTa.value);
                if (!bodyDiv.childNodes.length) {
                    var emptyPara = document.createElement('p');
                    emptyPara.appendChild(document.createElement('br'));
                    bodyDiv.appendChild(emptyPara);
                }
                bindEditorEvents(bodyDiv, compose);
            }
        }
    }

    document.addEventListener('focusin', function (ev) {
        var compose = closest(ev.target, '.email-template-compose');
        if (compose) {
            markEmailComposeEditing(compose);
        }
    }, true);

    document.addEventListener('mousedown', function (ev) {
        if (closest(ev.target, '.email-template-compose')) {
            return;
        }
        clearEmailComposeEditing();
    }, true);

    document.addEventListener('mousedown', function (ev) {
        if (closest(ev.target, '.email-template-token-subj, .email-template-token-body, .email-template-format-btn')) {
            ev.preventDefault();
        }
    });

    document.addEventListener('click', function (ev) {
        var subBtn = closest(ev.target, '.email-template-token-subj');
        if (subBtn) {
            ev.preventDefault();
            insertChipIntoEditor(closest(subBtn, '.email-template-compose'), subBtn, 'data-subject-compose-id');
            return;
        }

        var bodyBtn = closest(ev.target, '.email-template-token-body');
        if (bodyBtn) {
            ev.preventDefault();
            insertChipIntoEditor(closest(bodyBtn, '.email-template-compose'), bodyBtn, 'data-body-compose-id');
            return;
        }

        var formatBtn = closest(ev.target, '.email-template-format-btn');
        if (formatBtn) {
            ev.preventDefault();
            var composeFmt = closest(formatBtn, '.email-template-compose');
            if (!composeFmt) {
                return;
            }
            var command = formatBtn.getAttribute('data-command');
            applyBodyCommand(composeFmt, command, formatBtn.getAttribute('data-command-value'));
            return;
        }

        var editBtn = closest(ev.target, '.email-template-edit-btn');
        if (editBtn) {
            ev.preventDefault();
            var composeEdit = closest(editBtn, '.email-template-compose');
            if (!composeEdit) {
                return;
            }
            markEmailComposeEditing(composeEdit);
            var body = document.getElementById(composeEdit.getAttribute('data-body-compose-id'));
            if (body) {
                body.focus();
                if (body.scrollIntoView) {
                    body.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }
        }
    });

    function showBootstrapModal(id) {
        var el = document.getElementById(id);
        if (!el || !window.jQuery || !window.jQuery.fn || !window.jQuery.fn.modal) {
            return;
        }
        window.jQuery(el).modal('show');
    }

    function hideBootstrapModal(id) {
        var el = document.getElementById(id);
        if (!el || !window.jQuery || !window.jQuery.fn || !window.jQuery.fn.modal) {
            return;
        }
        window.jQuery(el).modal('hide');
    }

    function bindDialogs() {
        var resetBtn = document.getElementById('resetEmailTemplatesBtn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function (ev) {
                ev.preventDefault();
                showBootstrapModal('resetEmailTemplatesModal');
            });
        }

        var resetConfirm = document.getElementById('resetEmailTemplatesConfirm');
        if (resetConfirm) {
            resetConfirm.addEventListener('click', function () {
                var resetForm = document.getElementById('resetEmailTemplatesForm');
                if (!resetForm) {
                    return;
                }
                hideBootstrapModal('resetEmailTemplatesModal');
                resetForm.submit();
            });
        }
    }

    function init() {
        enableTemplateStorages();
        hydrateEditors();
        bindDialogs();

        var form = document.getElementById('emailTemplatesForm');
        if (form) {
            form.addEventListener('submit', function () {
                syncAllStorages();
            }, true);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
}
