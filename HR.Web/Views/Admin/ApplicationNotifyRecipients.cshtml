@model HR.Web.ViewModels.ApplicationNotifyRecipientsPageViewModel
@using HR.Web.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Application notifications";
}

<div class="container mt-4">
    <h2 class="mb-3">Application notifications</h2>

    <p class="text-muted">
        Configure who receives an email when a candidate submits a new application. Each recipient can require login to view details,
        or receive a read-only link that works without signing in (expires after 30 days).
    </p>

    @if (Model.IsSuperAdmin && Model.CompanyChoices != null && Model.CompanyChoices.Any())
    {
        using (Html.BeginForm("ApplicationNotifyRecipients", "Admin", FormMethod.Get, new { @class = "mb-4" }))
        {
            <div class="form-row align-items-end">
                <div class="form-group col-md-6 mb-0">
                    <label for="companyPicker">Company</label>
                    <select name="companyId" id="companyPicker" class="form-control" onchange="this.form.submit()">
                        <option value="">-- Select company --</option>
                        @foreach (var c in Model.CompanyChoices)
                        {
                            <option value="@c.Id" @(Model.CompanyId == c.Id ? "selected" : null)>@c.Name</option>
                        }
                    </select>
                </div>
            </div>
        }
    }

    @if (!Model.CompanyId.HasValue)
    {
        <div class="alert alert-info">@Model.CompanyName</div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header font-weight-bold">
                <i class="fas fa-building mr-2"></i>@Model.CompanyName
            </div>
            <div class="card-body">
                <h5 class="mb-3">Notification recipients</h5>
                @if (Model.Recipients == null || !Model.Recipients.Any())
                {
                    <p class="text-muted mb-0">No recipients configured yet. Add one below.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="thead-light">
                                <tr>
                                    <th>Email</th>
                                    <th>Label</th>
                                    <th>Access</th>
                                    <th>Active</th>
                                    <th style="width: 220px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Recipients)
                                {
                                    var formId = "editRecipient" + row.Id;
                                    <tr>
                                        <td colspan="5" class="p-0">
                                            @using (Html.BeginForm("UpdateApplicationNotifyRecipient", "Admin", FormMethod.Post, new { id = formId }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("Id", row.Id)
                                                @Html.Hidden("CompanyId", Model.CompanyId.Value)
                                                if (Model.IsSuperAdmin)
                                                {
                                                    @Html.Hidden("companyId", Model.CompanyId.Value)
                                                }
                                                <table class="table table-sm mb-0">
                                                    <tr>
                                                        <td style="width: 22%;">
                                                            <input name="Email" class="form-control form-control-sm" type="email" value="@row.Email" required />
                                                        </td>
                                                        <td style="width: 18%;">
                                                            <input name="Label" class="form-control form-control-sm" value="@row.Label" placeholder="Optional label" />
                                                        </td>
                                                        <td style="width: 22%;">
                                                            <select name="AccessMode" class="form-control form-control-sm">
                                                                <option value="@ApplicationNotifyAccessModes.LoginRequired" @(row.AccessMode == ApplicationNotifyAccessModes.LoginRequired ? "selected" : null)>Login required</option>
                                                                <option value="@ApplicationNotifyAccessModes.PublicReadOnly" @(row.AccessMode == ApplicationNotifyAccessModes.PublicReadOnly ? "selected" : null)>No login (read-only link)</option>
                                                            </select>
                                                        </td>
                                                        <td style="width: 10%;" class="text-center">
                                                            <input type="checkbox" name="IsActive" value="true" @(row.IsActive ? "checked" : null) />
                                                        </td>
                                                        <td style="width: 28%;" class="text-right">
                                                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                                        </td>
                                                    </tr>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="text-right border-0 pt-0 pb-2">
                                            @using (Html.BeginForm("DeleteApplicationNotifyRecipient", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", row.Id)
                                                if (Model.IsSuperAdmin)
                                                {
                                                    @Html.Hidden("companyId", Model.CompanyId.Value)
                                                }
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this notification recipient?');">
                                                    Remove @row.Email
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <hr />
                <h5 class="mb-3">Add recipient</h5>
                @using (Html.BeginForm("AddApplicationNotifyRecipient", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.NewEntry.CompanyId)
                    if (Model.CompanyUsersForPick != null && Model.CompanyUsersForPick.Any())
                    {
                        <div class="form-group">
                            <label for="addFromUserId">Add from company user</label>
                            <select name="addFromUserId" id="addFromUserId" class="form-control" style="max-width: 36rem;">
                                <option value="">Optional: select a user (uses their email)</option>
                                @foreach (var u in Model.CompanyUsersForPick)
                                {
                                    <option value="@u.Id">@u.DisplayName - @u.Email</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.NewEntry.Email)
                            @Html.TextBoxFor(m => m.NewEntry.Email, new { @class = "form-control", type = "email", placeholder = "hr@company.com" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(m => m.NewEntry.Label)
                            @Html.TextBoxFor(m => m.NewEntry.Label, new { @class = "form-control", placeholder = "e.g. Hiring manager" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(m => m.NewEntry.AccessMode)
                            @Html.DropDownListFor(
                                m => m.NewEntry.AccessMode,
                                new SelectList(new[]
                                {
                                    new SelectListItem { Text = "Login required", Value = ApplicationNotifyAccessModes.LoginRequired },
                                    new SelectListItem { Text = "No login (read-only link)", Value = ApplicationNotifyAccessModes.PublicReadOnly }
                                }, "Value", "Text"),
                                new { @class = "form-control" })
                        </div>
                        <div class="form-group col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary btn-block">Add</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
