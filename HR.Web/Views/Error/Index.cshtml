@model Exception
@using HR.Web.Helpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Error";
    ViewBag.SuppressPageHero = true;
    ViewBag.HideNavbar = true;
    var error = Model ?? ViewBag.LastError as Exception;
    var showDetails = AppConfig.ShowDetailedErrors || HttpContext.Current == null || !HttpContext.Current.IsCustomErrorEnabled;
}

<div style="min-height:60vh; display:flex; align-items:center; justify-content:center;">
    <div style="text-align:center; max-width:720px; padding:2rem; width:100%;">
        <div style="margin-bottom:1rem;" aria-hidden="true">
            <i class="fas fa-exclamation-triangle text-danger" style="font-size:4rem;"></i>
        </div>
        <h1 style="font-size:2rem; color:#dc3545; margin-bottom:0.5rem;">Something went wrong</h1>
        <p style="color:#6c757d; margin-bottom:2rem;">
            An unexpected error occurred while processing your request.
            @if (!showDetails)
            {
                @:Our team has been notified. Please try again or contact support if the problem persists.
            }
        </p>

        @if (showDetails && error != null)
        {
            <div class="text-left mt-4 p-3 bg-light rounded text-danger" style="font-family: monospace; font-size: 0.85rem;">
                <p><strong>Exception:</strong> @error.Message</p>
                <p><strong>Type:</strong> @error.GetType().FullName</p>
                @if (error.InnerException != null)
                {
                    <p><strong>Inner:</strong> @error.InnerException.Message</p>
                }
                <hr />
                <pre class="overflow-auto text-dark" style="max-height: 360px; white-space: pre-wrap;">@error.StackTrace</pre>
            </div>
        }

        <div class="mt-4">
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary">
                <i class="fas fa-home mr-2"></i> Go to Homepage
            </a>
        </div>
    </div>
</div>
