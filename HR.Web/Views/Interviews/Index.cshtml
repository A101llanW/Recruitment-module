@model IEnumerable<HR.Web.Models.Interview>
@using HR.Web.ViewModels

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Interviews";
    var canManageInterviews = ViewBag.CanManageInterviews != null ? (bool)ViewBag.CanManageInterviews : false;
    var panelistsForCc = ViewBag.EmailCcPanelists as List<HR.Web.Models.User> ?? new List<HR.Web.Models.User>();
    var hrContactsForCc = ViewBag.EmailCcHrContacts as List<HR.Web.Models.CompanyHrCcEmail> ?? new List<HR.Web.Models.CompanyHrCcEmail>();
    Uri parsedManageHrCcUrl;
    var manageHrCcUrl = Uri.TryCreate(Url.Action("HrCcEmails", "Admin"), UriKind.RelativeOrAbsolute, out parsedManageHrCcUrl)
        ? parsedManageHrCcUrl
        : null;
    var applicationsWithoutScheduledInterview = ViewBag.ApplicationsWithoutScheduledInterview as List<HR.Web.Models.Application>
        ?? new List<HR.Web.Models.Application>();

    var interviewEmailSuccess = TempData["InterviewEmailSuccess"] as string;
    var interviewEmailInfo = TempData["InterviewEmailInfo"] as string;
    var interviewEmailError = TempData["InterviewEmailError"] as string;
    var bookingError = TempData["Error"] as string;

    var resumeEmailMessage = ViewBag.ResumeEmailMessage as string;
    var resumeEmailApplicationId = 0;
    if (ViewBag.ResumeEmailApplicationId != null)
    {
        int.TryParse(ViewBag.ResumeEmailApplicationId.ToString(), out resumeEmailApplicationId);
    }

    var schedulePromptApplicationId = 0;
    if (TempData["InterviewEmailSchedulePromptApplicationId"] != null)
    {
        int.TryParse(TempData["InterviewEmailSchedulePromptApplicationId"].ToString(), out schedulePromptApplicationId);
    }
    var schedulePromptCandidateName = TempData["InterviewEmailSchedulePromptCandidateName"] as string;

    var scheduleRedirectUrl = schedulePromptApplicationId > 0
        ? (Url.Action("Index", "Applications", new
        {
            bookInterviewApplicationId = schedulePromptApplicationId,
            returnTo = "interviews",
            resumeEmailApplicationId = schedulePromptApplicationId
        }) + "#application-card-" + schedulePromptApplicationId)
        : null;
}

<style>
    .email-workflow-modal .modal-dialog {
        width: 96vw;
        max-width: 920px;
        margin: 1.5vh auto;
        pointer-events: auto;
    }

    .email-workflow-modal.show {
        pointer-events: auto;
    }

    .email-workflow-modal .modal-content {
        display: flex;
        flex-direction: column;
        max-height: 92vh;
        min-height: 0;
        border-radius: 12px;
        overflow: hidden;
    }

    .email-workflow-modal .modal-content > form {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        max-height: 92vh;
        overflow: hidden;
    }

    .email-workflow-modal .modal-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .email-workflow-modal .modal-header,
    .email-workflow-modal .modal-footer {
        flex-shrink: 0;
    }

    .email-choice-card {
        border: 1px solid var(--app-border, #dbe5f0);
        border-radius: 12px;
        padding: 18px;
        background: var(--app-paper, #f8fbff);
    }

    .interview-email-template-compose {
        border: 1px solid var(--app-border, #dbe5f0);
        border-radius: 10px;
        background: #fff;
    }

    .tox-silver-sink,
    .tox-tinymce-aux {
        z-index: 200000 !important;
    }
</style>

<div>
    <div class="app-panel-soft">
        <h3 class="app-section-title mb-3">
            <i class="fas fa-calendar-check"></i> Scheduled Interviews
        </h3>

        @if (!string.IsNullOrWhiteSpace(interviewEmailSuccess))
        {
            <div class="alert alert-success">@interviewEmailSuccess</div>
        }

        @if (!string.IsNullOrWhiteSpace(interviewEmailInfo))
        {
            <div class="alert alert-info">@interviewEmailInfo</div>
        }

        @if (!string.IsNullOrWhiteSpace(bookingError))
        {
            <div class="alert alert-danger">@bookingError</div>
        }

        @if (!string.IsNullOrWhiteSpace(interviewEmailError) && schedulePromptApplicationId <= 0)
        {
            <div class="alert alert-danger">@interviewEmailError</div>
        }

        @if (schedulePromptApplicationId > 0)
        {
            <div class="alert alert-warning">
                <div class="mb-2">
                    Candidate
                    <strong>@(string.IsNullOrWhiteSpace(schedulePromptCandidateName) ? "selected applicant" : schedulePromptCandidateName)</strong>
                    has no interview scheduled yet.
                </div>
                <div class="mb-2">Do you want to go book the interview now?</div>
                <a href="@scheduleRedirectUrl" class="btn btn-sm btn-primary mr-2">Yes, Book Interview</a>
                <a href="@Url.Action("Index", "Interviews")" class="btn btn-sm btn-secondary">No, Stay Here</a>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">No interviews scheduled yet.</div>
        }
        else
        {
            if (canManageInterviews)
            {
                var batchRecipientCount = Model
                    .Where(i => i.Application != null &&
                                i.Application.Applicant != null &&
                                !string.IsNullOrWhiteSpace(i.Application.Applicant.Email))
                    .Select(i => i.ApplicationId)
                    .Distinct()
                    .Count();
                var batchDefaultSubject = "Interview update";
                <div class="mb-3">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            onclick="openInterviewBulkEmailChoice(this)"
                            data-recipient-count="@batchRecipientCount"
                            data-default-subject="@batchDefaultSubject">
                        <i class="fas fa-envelope"></i> Email Candidates (Batch)
                    </button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Applicant</th>
                            <th class="d-none d-md-table-cell">Position</th>
                            <th class="d-none d-md-table-cell">Interviewer</th>
                            <th>Scheduled</th>
                            <th>Mode</th>
                            @if (canManageInterviews)
                            {
                                <th class="app-table-actions-col">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var applicantName = item.Application != null && item.Application.Applicant != null ? item.Application.Applicant.FullName : "N/A";
                            var positionTitle = item.Application != null && item.Application.Position != null ? item.Application.Position.Title : "N/A";
                            var interviewerName = item.Interviewer != null ? item.Interviewer.UserName : "N/A";
                            var isResumeTarget = resumeEmailApplicationId > 0 && resumeEmailApplicationId == item.ApplicationId;
                            var defaultSubject = string.Format(
                                "Interview update for {0}",
                                string.IsNullOrWhiteSpace(positionTitle) || positionTitle == "N/A" ? "your application" : positionTitle);

                            <tr>
                                <td class="align-middle">@applicantName</td>
                                <td class="align-middle d-none d-md-table-cell">@positionTitle</td>
                                <td class="align-middle d-none d-md-table-cell">@interviewerName</td>
                                <td class="align-middle">
                                    <span class="d-block">@item.ScheduledAt.ToString("d")</span>
                                    <small class="text-muted">@item.ScheduledAt.ToString("t")</small>
                                </td>
                                <td class="align-middle">
                                    <span class="badge badge-info">@item.Mode</span>
                                </td>
                                @if (canManageInterviews)
                                {
                                    <td class="align-middle">
                                        <div class="d-flex flex-wrap mb-2">
                                            @Html.ActionLink(
                                                "Reschedule",
                                                "Edit",
                                                "Interviews",
                                                new { id = item.Id },
                                                new { @class = "btn btn-sm btn-blue mr-2 mb-2" }
                                            )
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary mb-2 interview-email-trigger"
                                                    onclick="openInterviewCandidateEmailChoice(this)"
                                                    data-application-id="@item.ApplicationId"
                                                    data-candidate-name="@applicantName"
                                                    data-position-title="@(positionTitle == "N/A" ? "your application" : positionTitle)"
                                                    data-default-subject="@defaultSubject"
                                                    data-resume-draft="@(isResumeTarget ? (resumeEmailMessage ?? string.Empty) : string.Empty)"
                                                    data-resume-auto-open="@(isResumeTarget ? "true" : "false")">
                                                <i class="fas fa-envelope"></i> Email Candidate
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (canManageInterviews && applicationsWithoutScheduledInterview.Any())
    {
        <div class="app-panel-soft">
            <h3 class="app-section-title mb-3">
                <i class="fas fa-exclamation-circle"></i> Candidates Without Scheduled Interview
            </h3>
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Applicant</th>
                            <th class="d-none d-md-table-cell">Position</th>
                            <th>Applied</th>
                            <th class="app-table-actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in applicationsWithoutScheduledInterview)
                        {
                            var applicantName = app.Applicant != null ? app.Applicant.FullName : "N/A";
                            var positionTitle = app.Position != null ? app.Position.Title : "N/A";
                            var unscheduledDefaultSubject = string.Format(
                                "Interview update for {0}",
                                string.IsNullOrWhiteSpace(positionTitle) || positionTitle == "N/A" ? "your application" : positionTitle);
                            var bookUrl = Url.Action("Index", "Applications", new
                            {
                                bookInterviewApplicationId = app.Id,
                                returnTo = "interviews",
                                resumeEmailApplicationId = app.Id
                            }) + "#application-card-" + app.Id;

                            <tr>
                                <td class="align-middle">@applicantName</td>
                                <td class="align-middle d-none d-md-table-cell">@positionTitle</td>
                                <td class="align-middle">@app.AppliedOn.ToString("d")</td>
                                <td class="align-middle">
                                    <div class="d-flex flex-wrap mb-2">
                                        <a href="@bookUrl" class="btn btn-sm btn-success mr-2 mb-2">
                                            <i class="fas fa-calendar-plus"></i> Book Interview
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary mb-2"
                                                onclick="openInterviewCandidateEmailChoice(this)"
                                                data-application-id="@app.Id"
                                                data-candidate-name="@applicantName"
                                                data-position-title="@(positionTitle == "N/A" ? "your application" : positionTitle)"
                                                data-default-subject="@unscheduledDefaultSubject"
                                                data-resume-draft=""
                                                data-resume-auto-open="false">
                                            <i class="fas fa-envelope"></i> Email Candidate
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Modals {
@if (canManageInterviews)
{
    <!-- Email workflow modals render outside .app-page so Bootstrap backdrop stacks correctly -->
    <div class="modal fade email-workflow-modal" id="interviewEmailChoiceModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title mb-0"><i class="fas fa-envelope mr-2"></i>Email Interview Candidate</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-center text-md-left">
                        <div class="font-weight-bold" id="interviewEmailChoiceCandidateLabel"></div>
                        <div class="text-muted small" id="interviewEmailChoicePositionLabel"></div>
                    </div>
                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-stretch mx-auto" style="gap: 1rem; max-width: 820px;">
                        <div class="email-choice-card flex-fill" style="max-width: 400px; margin-left: auto; margin-right: auto;">
                            <h6 class="font-weight-bold mb-2 text-center">Use Template</h6>
                            <p class="text-muted small mb-3 text-center">Load your company's saved email template (merged with this candidate's interview details), edit it, then send.</p>
                            <div class="text-center">
                                <button type="button" class="btn btn-outline-primary px-4" data-interview-email-action="template">
                                    <i class="fas fa-file-alt mr-2"></i>Use Template
                                </button>
                            </div>
                        </div>
                        <div class="email-choice-card flex-fill" style="max-width: 400px; margin-left: auto; margin-right: auto;">
                            <h6 class="font-weight-bold mb-2 text-center">Compose from Scratch</h6>
                            <p class="text-muted small mb-3 text-center">Write a custom subject and message with rich formatting for this candidate.</p>
                            <div class="text-center">
                                <button type="button" class="btn btn-outline-secondary px-4" data-interview-email-action="scratch">
                                    <i class="fas fa-pen mr-2"></i>Compose from Scratch
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade email-workflow-modal" id="interviewEmailEditorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <form action="@Url.Action("SendInterviewCandidateEmail", "Interviews")" method="post" id="interviewEmailEditorForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title mb-0" id="interviewEmailEditorTitle">Compose Email</h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="applicationId" id="interviewEmailEditorApplicationId" />
                        <input type="hidden" name="composeMode" id="interviewEmailEditorComposeMode" value="template_edit" />
                        <input type="hidden" name="templateKey" value="interview_candidate_standard" />

                        <div class="mb-3">
                            <div class="font-weight-bold" id="interviewEmailEditorCandidateLabel"></div>
                            <div class="text-muted small" id="interviewEmailEditorPositionLabel"></div>
                        </div>

                        <div class="mb-3" id="interviewEmailTemplateSelectorSection">
                            <label class="font-weight-bold mb-1">Template</label>
                            <div class="form-control bg-light">Interview candidate - standard (saved template)</div>
                        </div>

                        <div class="mb-3 interview-email-template-compose p-3">
                            <h6 class="text-uppercase text-muted small font-weight-bold mb-2">Compose this email</h6>
                            <p class="small text-muted mb-3">Scroll to CC options and <strong>Send</strong>.</p>
                            <label class="font-weight-bold mb-1" for="interviewEmailEditorSubject">Subject line</label>
                            <input type="text" id="interviewEmailEditorSubject" name="subject" class="form-control mb-3" maxlength="255" />
                            <label class="font-weight-bold mb-1" for="interviewEmailEditorBody">Message</label>
                            <textarea id="interviewEmailEditorBody"
                                      name="body"
                                      class="form-control"
                                      rows="12"></textarea>
                            <small class="text-muted d-block mb-3">Maximum length 20,000 characters (including HTML).</small>
                        </div>

                        <hr class="my-3" />
                        <p class="small font-weight-bold text-muted mb-2">Copy on send (optional)</p>
                        @Html.Partial("_CandidateEmailCcFields", new CandidateEmailCcFieldsModel
                        {
                            Prefix = "interviewEmailEditor",
                            Panelists = panelistsForCc,
                            HrContacts = hrContactsForCc,
                            ManageHrCcUrl = manageHrCcUrl
                        })
                    </div>
                    <div class="modal-footer flex-shrink-0 border-top">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane mr-1"></i>Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade email-workflow-modal" id="interviewBulkEmailChoiceModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title mb-0"><i class="fas fa-envelope-open-text mr-2"></i>Email All Interview Candidates</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-center text-md-left">
                        <div class="font-weight-bold">Scheduled interview candidates</div>
                        <div class="text-muted small" id="interviewBulkEmailChoiceCountLabel"></div>
                    </div>
                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-stretch mx-auto" style="gap: 1rem; max-width: 820px;">
                        <div class="email-choice-card flex-fill" style="max-width: 400px; margin-left: auto; margin-right: auto;">
                            <h6 class="font-weight-bold mb-2 text-center">Use Template</h6>
                            <p class="text-muted small mb-3 text-center">Load your company's saved email template (sample merge), edit it, then send to all scheduled candidates.</p>
                            <div class="text-center">
                                <button type="button" class="btn btn-outline-primary px-4" data-interview-bulk-email-action="template">
                                    <i class="fas fa-file-alt mr-2"></i>Use Template
                                </button>
                            </div>
                        </div>
                        <div class="email-choice-card flex-fill" style="max-width: 400px; margin-left: auto; margin-right: auto;">
                            <h6 class="font-weight-bold mb-2 text-center">Compose from Scratch</h6>
                            <p class="text-muted small mb-3 text-center">Write a custom subject and message to send to every scheduled candidate.</p>
                            <div class="text-center">
                                <button type="button" class="btn btn-outline-secondary px-4" data-interview-bulk-email-action="scratch">
                                    <i class="fas fa-pen mr-2"></i>Compose from Scratch
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade email-workflow-modal" id="interviewBulkEmailEditorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <form action="@Url.Action("SendInterviewCandidatesBatchEmail", "Interviews")" method="post" id="interviewBulkEmailEditorForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title mb-0" id="interviewBulkEmailEditorTitle">Compose Bulk Email</h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="composeMode" id="interviewBulkEmailEditorComposeMode" value="scratch" />
                        <input type="hidden" name="templateKey" value="interview_candidate_standard" />

                        <div class="mb-3">
                            <div class="font-weight-bold">Scheduled interview candidates</div>
                            <div class="text-muted small" id="interviewBulkEmailEditorCountLabel"></div>
                        </div>

                        <div class="mb-3 d-none" id="interviewBulkTemplateSelectorSection">
                            <label class="font-weight-bold mb-1">Template</label>
                            <div class="form-control bg-light">Interview candidate - standard (saved template)</div>
                        </div>

                        <div class="mb-3 interview-email-template-compose p-3">
                            <h6 class="text-uppercase text-muted small font-weight-bold mb-2">Compose this email</h6>
                            <p class="small text-muted mb-3">Preview uses one candidate as a sample. Scroll to CC and <strong>Send to All</strong>.</p>
                            <label class="font-weight-bold mb-1" for="interviewBulkEmailEditorSubject">Subject line</label>
                            <input type="text" id="interviewBulkEmailEditorSubject" name="subject" class="form-control mb-3" maxlength="255" />
                            <label class="font-weight-bold mb-1" for="interviewBulkEmailEditorBody">Message</label>
                            <textarea id="interviewBulkEmailEditorBody"
                                      name="body"
                                      class="form-control"
                                      rows="12"></textarea>
                            <small class="text-muted d-block mb-3">Maximum length 20,000 characters (including HTML).</small>
                        </div>

                        <hr class="my-3" />
                        <p class="small font-weight-bold text-muted mb-2">Copy on send (optional)</p>
                        @Html.Partial("_CandidateEmailCcFields", new CandidateEmailCcFieldsModel
                        {
                            Prefix = "interviewBulkEmailEditor",
                            Panelists = panelistsForCc,
                            HrContacts = hrContactsForCc,
                            ManageHrCcUrl = manageHrCcUrl
                        })
                    </div>
                    <div class="modal-footer flex-shrink-0 border-top">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane mr-1"></i>Send to All
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
}

@section Scripts {
    @if (canManageInterviews)
    {
        <script src="@Url.Content("~/Scripts/email-workflow-modals.js")"></script>
        <script src="@Url.Content("~/Scripts/tinymce-loader.js")"></script>
        <script>
            function syncInterviewEmailEditorToForm() {
                if (typeof tinymce !== 'undefined') {
                    tinymce.triggerSave();
                }
            }

            function setInterviewSingleEditorHtml(html) {
                var ed = typeof tinymce !== 'undefined' ? tinymce.get('interviewEmailEditorBody') : null;
                if (ed) {
                    ed.setContent(html || '');
                } else {
                    var ta = document.getElementById('interviewEmailEditorBody');
                    if (ta) ta.value = html || '';
                }
            }

            function setInterviewBulkEditorHtml(html) {
                var ed = typeof tinymce !== 'undefined' ? tinymce.get('interviewBulkEmailEditorBody') : null;
                if (ed) {
                    ed.setContent(html || '');
                } else {
                    var ta = document.getElementById('interviewBulkEmailEditorBody');
                    if (ta) ta.value = html || '';
                }
            }

            function ensureInterviewSingleTinyMce(done) {
                var loader = window.HrTinyMceLoader;
                if (!loader) {
                    if (done) done();
                    return;
                }
                loader.removeExcept('interviewEmailEditorBody');
                if (loader.get('interviewEmailEditorBody')) {
                    if (done) done();
                    return;
                }
                var finish = window.HrEmailWorkflow && window.HrEmailWorkflow.withCallbackTimeout
                    ? window.HrEmailWorkflow.withCallbackTimeout(done, 10000)
                    : done;
                loader.whenReady(function (tinymce, error) {
                    if (!tinymce || error) {
                        if (finish) finish();
                        return;
                    }
                    loader.init({
                        selector: '#interviewEmailEditorBody',
                        height: 320,
                        plugins: 'link lists autoresize',
                        toolbar: 'undo redo | styles | bold italic underline | bullist numlist | link removeformat',
                        setup: function (editor) {
                            editor.on('init', function () {
                                if (finish) finish();
                            });
                        }
                    }).catch(function () {
                        if (finish) finish();
                    });
                });
            }

            function ensureInterviewBulkTinyMce(done) {
                var loader = window.HrTinyMceLoader;
                if (!loader) {
                    if (done) done();
                    return;
                }
                loader.removeExcept('interviewBulkEmailEditorBody');
                if (loader.get('interviewBulkEmailEditorBody')) {
                    if (done) done();
                    return;
                }
                var finish = window.HrEmailWorkflow && window.HrEmailWorkflow.withCallbackTimeout
                    ? window.HrEmailWorkflow.withCallbackTimeout(done, 10000)
                    : done;
                loader.whenReady(function (tinymce, error) {
                    if (!tinymce || error) {
                        if (finish) finish();
                        return;
                    }
                    loader.init({
                        selector: '#interviewBulkEmailEditorBody',
                        height: 320,
                        plugins: 'link lists autoresize',
                        toolbar: 'undo redo | styles | bold italic underline | bullist numlist | link removeformat',
                        setup: function (editor) {
                            editor.on('init', function () {
                                if (finish) finish();
                            });
                        }
                    }).catch(function () {
                        if (finish) finish();
                    });
                });
            }

            var interviewEmailWorkflowContext = {
                applicationId: 0,
                candidateName: '',
                positionTitle: '',
                defaultSubject: '',
                resumeDraft: ''
            };

            function openInterviewCandidateEmailChoice(button) {
                if (!button) return;

                interviewEmailWorkflowContext.applicationId = parseInt(button.getAttribute('data-application-id') || '0', 10) || 0;
                interviewEmailWorkflowContext.candidateName = button.getAttribute('data-candidate-name') || 'Candidate';
                interviewEmailWorkflowContext.positionTitle = button.getAttribute('data-position-title') || 'your application';
                interviewEmailWorkflowContext.defaultSubject = button.getAttribute('data-default-subject') || ('Interview update for ' + interviewEmailWorkflowContext.positionTitle);
                interviewEmailWorkflowContext.resumeDraft = button.getAttribute('data-resume-draft') || '';

                var candidateLabel = document.getElementById('interviewEmailChoiceCandidateLabel');
                var positionLabel = document.getElementById('interviewEmailChoicePositionLabel');
                if (candidateLabel) candidateLabel.textContent = interviewEmailWorkflowContext.candidateName;
                if (positionLabel) positionLabel.textContent = 'Position: ' + interviewEmailWorkflowContext.positionTitle;

                $('#interviewEmailChoiceModal').modal('show');
            }

            function resetInterviewEmailEditorCcState() {
                var pToggle = document.getElementById('interviewEmailEditorCcPanelistsToggle');
                var pContainer = document.getElementById('interviewEmailEditorCcPanelistsContainer');
                var hToggle = document.getElementById('interviewEmailEditorCcHrToggle');
                var hContainer = document.getElementById('interviewEmailEditorCcHrContainer');
                if (pToggle) pToggle.checked = false;
                if (hToggle) hToggle.checked = false;
                if (pContainer) {
                    pContainer.classList.add('d-none');
                    Array.prototype.forEach.call(pContainer.querySelectorAll('input[type="checkbox"][name="selectedPanelistIds"]'), function (box) {
                        box.checked = false;
                    });
                }
                if (hContainer) {
                    hContainer.classList.add('d-none');
                    Array.prototype.forEach.call(hContainer.querySelectorAll('input[type="checkbox"][name="selectedHrCcIds"]'), function (box) {
                        box.checked = false;
                    });
                }
            }

            function openInterviewCandidateTemplateEditor() {
                if (!interviewEmailWorkflowContext.applicationId) return;

                document.getElementById('interviewEmailEditorTitle').textContent = 'Template Email Editor';
                document.getElementById('interviewEmailEditorApplicationId').value = interviewEmailWorkflowContext.applicationId;
                document.getElementById('interviewEmailEditorComposeMode').value = 'template_edit';
                document.getElementById('interviewEmailEditorCandidateLabel').textContent = interviewEmailWorkflowContext.candidateName;
                document.getElementById('interviewEmailEditorPositionLabel').textContent = 'Position: ' + interviewEmailWorkflowContext.positionTitle;
                document.getElementById('interviewEmailTemplateSelectorSection').classList.remove('d-none');

                resetInterviewEmailEditorCcState();
                $('#interviewEmailEditorModal').data('interviewSingleLoadPreview', true);
                HrEmailWorkflow.swapModal('#interviewEmailChoiceModal', '#interviewEmailEditorModal');
            }

            function openInterviewCandidateScratchEditor() {
                if (!interviewEmailWorkflowContext.applicationId) return;

                document.getElementById('interviewEmailEditorTitle').textContent = 'Compose Email from Scratch';
                document.getElementById('interviewEmailEditorApplicationId').value = interviewEmailWorkflowContext.applicationId;
                document.getElementById('interviewEmailEditorComposeMode').value = 'scratch';
                document.getElementById('interviewEmailEditorCandidateLabel').textContent = interviewEmailWorkflowContext.candidateName;
                document.getElementById('interviewEmailEditorPositionLabel').textContent = 'Position: ' + interviewEmailWorkflowContext.positionTitle;
                document.getElementById('interviewEmailTemplateSelectorSection').classList.add('d-none');
                document.getElementById('interviewEmailEditorSubject').value = interviewEmailWorkflowContext.defaultSubject;

                var draft = interviewEmailWorkflowContext.resumeDraft || '';
                setInterviewSingleEditorHtml(draft ? draft.replace(/\n/g, '<br/>') : '');

                resetInterviewEmailEditorCcState();
                $('#interviewEmailEditorModal').data('interviewSingleLoadPreview', false);
                HrEmailWorkflow.swapModal('#interviewEmailChoiceModal', '#interviewEmailEditorModal');
            }

            function reloadInterviewCandidateTemplatePreview() {
                if (!interviewEmailWorkflowContext.applicationId) return;

                var subjectInput = document.getElementById('interviewEmailEditorSubject');
                if (!subjectInput) return;

                setInterviewSingleEditorHtml('<p><em>Loading template...</em></p>');

                var previewUrl = '@Url.Action("GetInterviewCandidateTemplatePreview", "Interviews")'
                    + '?applicationId=' + encodeURIComponent(interviewEmailWorkflowContext.applicationId)
                    + '&templateKey=interview_candidate_standard';

                fetch(previewUrl, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Unable to load template preview.');
                        return response.json();
                    })
                    .then(function (result) {
                        if (!result || result.success !== true) {
                            throw new Error(result && result.message ? result.message : 'Unable to load template preview.');
                        }
                        subjectInput.value = result.subject || interviewEmailWorkflowContext.defaultSubject;
                        setInterviewSingleEditorHtml(result.bodyHtml || '');
                    })
                    .catch(function (error) {
                        subjectInput.value = interviewEmailWorkflowContext.defaultSubject;
                        setInterviewSingleEditorHtml('');
                        alert(error && error.message ? error.message : 'Unable to load template preview.');
                    });
            }

            var interviewBulkEmailWorkflowContext = {
                recipientCount: 0,
                defaultSubject: 'Interview update'
            };

            function openInterviewBulkEmailChoice(button) {
                if (!button) return;

                interviewBulkEmailWorkflowContext.recipientCount = parseInt(button.getAttribute('data-recipient-count') || '0', 10) || 0;
                interviewBulkEmailWorkflowContext.defaultSubject = button.getAttribute('data-default-subject') || 'Interview update';

                var countLabel = document.getElementById('interviewBulkEmailChoiceCountLabel');
                if (countLabel) countLabel.textContent = 'Recipients: ' + interviewBulkEmailWorkflowContext.recipientCount + ' candidate(s)';

                $('#interviewBulkEmailChoiceModal').modal('show');
            }

            function resetInterviewBulkEmailEditorCcState() {
                var pToggle = document.getElementById('interviewBulkEmailEditorCcPanelistsToggle');
                var pContainer = document.getElementById('interviewBulkEmailEditorCcPanelistsContainer');
                var hToggle = document.getElementById('interviewBulkEmailEditorCcHrToggle');
                var hContainer = document.getElementById('interviewBulkEmailEditorCcHrContainer');
                if (pToggle) pToggle.checked = false;
                if (hToggle) hToggle.checked = false;
                if (pContainer) {
                    pContainer.classList.add('d-none');
                    Array.prototype.forEach.call(pContainer.querySelectorAll('input[type="checkbox"][name="selectedPanelistIds"]'), function (box) {
                        box.checked = false;
                    });
                }
                if (hContainer) {
                    hContainer.classList.add('d-none');
                    Array.prototype.forEach.call(hContainer.querySelectorAll('input[type="checkbox"][name="selectedHrCcIds"]'), function (box) {
                        box.checked = false;
                    });
                }
            }

            function openInterviewBulkTemplateEditor() {
                document.getElementById('interviewBulkEmailEditorTitle').textContent = 'Template Bulk Email Editor';
                document.getElementById('interviewBulkEmailEditorComposeMode').value = 'template_edit';
                document.getElementById('interviewBulkEmailEditorCountLabel').textContent = 'Recipients: ' + interviewBulkEmailWorkflowContext.recipientCount + ' candidate(s)';
                document.getElementById('interviewBulkTemplateSelectorSection').classList.remove('d-none');

                resetInterviewBulkEmailEditorCcState();
                $('#interviewBulkEmailEditorModal').data('interviewBulkLoadPreview', true);
                HrEmailWorkflow.swapModal('#interviewBulkEmailChoiceModal', '#interviewBulkEmailEditorModal');
            }

            function openInterviewBulkScratchEditor() {
                document.getElementById('interviewBulkEmailEditorTitle').textContent = 'Compose Bulk Email from Scratch';
                document.getElementById('interviewBulkEmailEditorComposeMode').value = 'scratch';
                document.getElementById('interviewBulkEmailEditorCountLabel').textContent = 'Recipients: ' + interviewBulkEmailWorkflowContext.recipientCount + ' candidate(s)';
                document.getElementById('interviewBulkTemplateSelectorSection').classList.add('d-none');
                document.getElementById('interviewBulkEmailEditorSubject').value = interviewBulkEmailWorkflowContext.defaultSubject;
                setInterviewBulkEditorHtml('');

                resetInterviewBulkEmailEditorCcState();
                $('#interviewBulkEmailEditorModal').data('interviewBulkLoadPreview', false);
                HrEmailWorkflow.swapModal('#interviewBulkEmailChoiceModal', '#interviewBulkEmailEditorModal');
            }

            function toggleOptionalCcSection(toggleId, containerId, checkboxName) {
                var toggle = document.getElementById(toggleId);
                var container = document.getElementById(containerId);
                if (!toggle || !container) return;

                if (toggle.checked) {
                    container.classList.remove('d-none');
                } else {
                    container.classList.add('d-none');
                    var selector = 'input[type="checkbox"][name="' + checkboxName + '"]';
                    Array.prototype.forEach.call(container.querySelectorAll(selector), function (box) {
                        box.checked = false;
                    });
                }
            }

            function reloadInterviewBulkTemplatePreview() {
                var subjectInput = document.getElementById('interviewBulkEmailEditorSubject');
                if (!subjectInput) return;

                setInterviewBulkEditorHtml('<p><em>Loading template...</em></p>');

                var previewUrl = '@Url.Action("GetInterviewCandidatesBulkTemplatePreview", "Interviews")'
                    + '?templateKey=interview_candidate_standard';

                fetch(previewUrl, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin'
                })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Unable to load template preview.');
                        return response.json();
                    })
                    .then(function (result) {
                        if (!result || result.success !== true) {
                            throw new Error(result && result.message ? result.message : 'Unable to load template preview.');
                        }
                        subjectInput.value = result.subject || interviewBulkEmailWorkflowContext.defaultSubject;
                        setInterviewBulkEditorHtml(result.bodyHtml || '');
                    })
                    .catch(function (error) {
                        subjectInput.value = interviewBulkEmailWorkflowContext.defaultSubject;
                        setInterviewBulkEditorHtml('');
                        alert(error && error.message ? error.message : 'Unable to load template preview.');
                    });
            }

            $(function () {
                $(document).on('click', '[data-interview-email-action]', function (event) {
                    event.preventDefault();
                    var action = this.getAttribute('data-interview-email-action');
                    if (action === 'template') {
                        openInterviewCandidateTemplateEditor();
                    } else if (action === 'scratch') {
                        openInterviewCandidateScratchEditor();
                    }
                });

                $(document).on('click', '[data-interview-bulk-email-action]', function (event) {
                    event.preventDefault();
                    var action = this.getAttribute('data-interview-bulk-email-action');
                    if (action === 'template') {
                        openInterviewBulkTemplateEditor();
                    } else if (action === 'scratch') {
                        openInterviewBulkScratchEditor();
                    }
                });

                $('#interviewEmailEditorModal').on('shown.bs.modal', function () {
                    var loadPreview = $('#interviewEmailEditorModal').data('interviewSingleLoadPreview') === true;
                    ensureInterviewSingleTinyMce(function () {
                        if (loadPreview) {
                            $('#interviewEmailEditorModal').data('interviewSingleLoadPreview', false);
                            reloadInterviewCandidateTemplatePreview();
                        } else {
                            var ed = typeof tinymce !== 'undefined' ? tinymce.get('interviewEmailEditorBody') : null;
                            if (ed) {
                                var ta = document.getElementById('interviewEmailEditorBody');
                                var starter = (ta && ta.value) ? ta.value : '';
                                if (!starter || !starter.trim()) {
                                    starter = '<p></p>';
                                }
                                ed.setContent(starter);
                            }
                        }
                    });
                });
                $('#interviewEmailEditorModal').on('hidden.bs.modal', function () {
                    if (typeof tinymce !== 'undefined') {
                        var ed = tinymce.get('interviewEmailEditorBody');
                        if (ed) tinymce.remove(ed);
                    }
                });
                $('#interviewEmailEditorForm').on('submit', function () {
                    syncInterviewEmailEditorToForm();
                    var ta = document.getElementById('interviewEmailEditorBody');
                    if (ta && ta.value && ta.value.length > 20000) {
                        alert('Email body is too long (maximum 20000 characters).');
                        return false;
                    }
                });

                $('#interviewBulkEmailEditorModal').on('shown.bs.modal', function () {
                    var loadPreview = $('#interviewBulkEmailEditorModal').data('interviewBulkLoadPreview') === true;
                    ensureInterviewBulkTinyMce(function () {
                        if (loadPreview) {
                            $('#interviewBulkEmailEditorModal').data('interviewBulkLoadPreview', false);
                            reloadInterviewBulkTemplatePreview();
                        } else {
                            var ed = typeof tinymce !== 'undefined' ? tinymce.get('interviewBulkEmailEditorBody') : null;
                            if (ed) {
                                var ta = document.getElementById('interviewBulkEmailEditorBody');
                                var starter = (ta && ta.value) ? ta.value : '';
                                if (!starter || !starter.trim()) {
                                    starter = '<p></p>';
                                }
                                ed.setContent(starter);
                            }
                        }
                    });
                });
                $('#interviewBulkEmailEditorModal').on('hidden.bs.modal', function () {
                    if (typeof tinymce !== 'undefined') {
                        var ed = tinymce.get('interviewBulkEmailEditorBody');
                        if (ed) tinymce.remove(ed);
                    }
                });
                $('#interviewBulkEmailEditorForm').on('submit', function () {
                    syncInterviewEmailEditorToForm();
                    var ta = document.getElementById('interviewBulkEmailEditorBody');
                    if (ta && ta.value && ta.value.length > 20000) {
                        alert('Email body is too long (maximum 20000 characters).');
                        return false;
                    }
                });

                var resumeButton = document.querySelector('.interview-email-trigger[data-resume-auto-open="true"]');
                if (resumeButton) {
                    interviewEmailWorkflowContext.applicationId = parseInt(resumeButton.getAttribute('data-application-id') || '0', 10) || 0;
                    interviewEmailWorkflowContext.candidateName = resumeButton.getAttribute('data-candidate-name') || 'Candidate';
                    interviewEmailWorkflowContext.positionTitle = resumeButton.getAttribute('data-position-title') || 'your application';
                    interviewEmailWorkflowContext.defaultSubject = resumeButton.getAttribute('data-default-subject') || 'Interview update';
                    interviewEmailWorkflowContext.resumeDraft = resumeButton.getAttribute('data-resume-draft') || '';
                    openInterviewCandidateScratchEditor();
                }
            });
        </script>
    }
}
