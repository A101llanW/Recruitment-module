@model HR.Web.Models.Application
@{
    ViewBag.Title = "Application Details";
    var tenantToken = ViewBag.TenantToken as string ?? ViewContext.RouteData.Values["tenant"] as string;
    var questionnaireStageCount = ViewBag.QuestionnaireStageCountForDetails as int? ?? 1;
    var canOpenNextQuestionnaireStage = ViewBag.CanOpenNextQuestionnaireStage as bool? ?? false;
    var showQuestionnaireHiringPanel = ViewBag.ShowQuestionnaireHiringPanel as bool? ?? false;
    var canManageApplicationDetails = ViewBag.CanManageApplicationDetails as bool? ?? false;
    var canViewApplicationScores = ViewBag.CanViewApplicationScores as bool? ?? false;
}
<h3>Application</h3>
<dl class="row">
    <dt class="col-sm-3">Applicant</dt><dd class="col-sm-9">@(Model.Applicant != null ? Model.Applicant.FullName : "N/A")</dd>
    <dt class="col-sm-3">Position</dt><dd class="col-sm-9">@(Model.Position != null ? Model.Position.Title : "N/A")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Applied</dt><dd class="col-sm-9">@Model.AppliedOn</dd>
    @if (canViewApplicationScores && Model.Score.HasValue)
    {
        <dt class="col-sm-3">Score</dt>
        <dd class="col-sm-9">@Model.Score.Value.ToString("F1")</dd>
    }
    else if (canViewApplicationScores && !string.IsNullOrEmpty(Model.ScoreReason) && Model.ScoreReason.StartsWith("Scoring failed", System.StringComparison.OrdinalIgnoreCase))
    {
        <dt class="col-sm-3">Score</dt>
        <dd class="col-sm-9">
            <span class="badge badge-danger" title="@Model.ScoreReason">Scoring error</span>
        </dd>
    }
    @if (showQuestionnaireHiringPanel)
    {
        <dt class="col-sm-3">Questionnaire (hiring)</dt>
        <dd class="col-sm-9">
            @Math.Max(0, Model.LastCompletedQuestionnaireStage) of @questionnaireStageCount stage(s) completed
            @if (Model.PendingQuestionnaireStage.HasValue)
            {
                <span class="badge badge-warning text-dark">Stage @Model.PendingQuestionnaireStage.Value open for candidate</span>
            }
        </dd>
    }
</dl>
@if (canOpenNextQuestionnaireStage)
{
    <div class="mb-3">
        @using (Html.BeginForm("InviteNextQuestionnaireStage", "Applications", new { tenant = tenantToken }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("applicationId", Model.Id)
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <i class="fas fa-door-open"></i> Open next questionnaire stage
            </button>
        }
    </div>
}
@if (canManageApplicationDetails)
{
    <div class="mb-3">
        @using (Html.BeginForm("UpdateStatus", "Applications", new { tenant = tenantToken }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)
            <div class="form-row align-items-center">
                <div class="col-auto">
                    <input name="status" class="form-control" placeholder="New Status" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" type="submit">Update Status</button>
                </div>
            </div>
        }
    </div>
}
<div class="mt-3">
    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary btn-sm" })
    @if (Model.PendingQuestionnaireStage.HasValue)
    {
        @Html.ActionLink("Continue questionnaire", "Questionnaire", "Applications", new { positionId = Model.PositionId, tenant = tenantToken }, new { @class = "btn btn-primary btn-sm ml-2" })
    }
    @if (canManageApplicationDetails)
    {
        using (Html.BeginForm("DeleteConfirmed", "Applications", new { id = Model.Id, tenant = tenantToken }, FormMethod.Post, new { @class = "d-inline-block", onsubmit = "return confirm('Delete this application?');" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm ml-2">Delete</button>
        }
    }
</div>





























