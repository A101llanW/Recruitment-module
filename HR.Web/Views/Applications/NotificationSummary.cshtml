@model HR.Web.Services.ApplicationNotificationSummaryModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Application summary";
    ViewBag.SuppressPageHero = true;
    ViewBag.HideNavbar = true;
}

<div class="container mt-5 mb-5" style="max-width: 640px;">
    @if (Model == null || !Model.IsValid)
    {
        <div class="card shadow-sm border-warning">
            <div class="card-body text-center py-5">
                <i class="fas fa-link fa-2x text-warning mb-3"></i>
                <h3 class="h5">Link unavailable</h3>
                <p class="text-muted mb-0">@(Model != null ? Model.ErrorMessage : "This link is invalid.")</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h1 class="h5 mb-0">Application summary</h1>
                <small class="text-muted">Read-only view — @Model.CompanyName</small>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Candidate</dt>
                    <dd class="col-sm-8">@Model.CandidateName</dd>

                    <dt class="col-sm-4">Position</dt>
                    <dd class="col-sm-8">@Model.PositionTitle</dd>

                    <dt class="col-sm-4">Score</dt>
                    <dd class="col-sm-8">
                        @if (Model.HasScore && Model.Score.HasValue)
                        {
                            @Model.Score.Value.ToString("0.##")
                            @: points
                        }
                        else
                        {
                            <span class="text-muted">Pending</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Rank</dt>
                    <dd class="col-sm-8">@Model.RankDescription</dd>

                    <dt class="col-sm-4">Applied</dt>
                    <dd class="col-sm-8">@Model.AppliedOn.ToString("f")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>
            </div>
            <div class="card-footer text-muted small">
                This page shows summary information only. It does not list other candidates.
            </div>
        </div>
    }
</div>
