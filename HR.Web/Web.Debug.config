<?xml version="1.0" encoding="utf-8"?>
<!-- Applied when building Debug configuration in Visual Studio. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="AppEnvironment" value="Remote/Dev" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="LastRestart" value="2026-05-22-dev" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- Deployment-specific AES key for EncryptionHelper (credential blobs, encrypted settings). Do NOT commit real secrets. -->
    <add key="SystemEncryptionKey" value="" xdt:Transform="InsertIfMissing" xdt:Locator="Match(key)" />
    <!-- Local dev only: set to true to allow legacy hardcoded fallback in DEBUG builds when SystemEncryptionKey is empty. -->
    <add key="AllowInsecureDefaultEncryptionKey" value="false" xdt:Transform="InsertIfMissing" xdt:Locator="Match(key)" />
  </appSettings>
  <!-- Local VS Debug keeps customErrors Off for yellow-page diagnostics.
       IIS deploy via tools/dev/Sync-Publish.ps1 applies Release-like settings
       (customErrors On, httpErrors PassThrough) regardless of build config. -->
  <system.web>
    <customErrors mode="Off" xdt:Transform="Replace" />
    <compilation debug="true" xdt:Transform="SetAttributes(debug)" />
  </system.web>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" errorMode="Detailed" xdt:Transform="Replace" />
  </system.webServer>
</configuration>
